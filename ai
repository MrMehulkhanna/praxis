#!/usr/bin/env python3
"""
ai — control interface for AIOS (local-first AI on this machine).

  ai "why is my GPU not detected?"   terminal agent: gathers evidence, answers, may propose a fix
  ai ask "…"                         plain chat (no diagnostics)
  ai code "…"                        coding task (routes to the code model, adds cwd context)
  ai see photo.png ["question"]      ask about an image (Qwen3-VL); --image FILE works on any command
  ai model [list|auto|<id>|stop]     show / select / auto-route / unload
  ai models · ai providers · ai usage · ai status · ai logs [-f] · ai activity
  ai system · ai hardware · ai gpu · ai cpu · ai memory · ai storage · ai services
  ai voice [test|commands]           voice pipeline status / test / allowed phrases
  ai config [key value]              model · budget · thinking · cloud-for
  ai doctor · ai update · ai cleanup [--apply] · ai audit · ai do "…" · ai approve
  ai rag [add|q|stats|embed]         retrieval over your own files (FTS5 + optional vectors)
  ai forget [--all] [--yes]          delete stored conversations (--all: every stored object)
  --json  machine-readable   --model <id>  one-shot override   --auto  force routing

Exit codes: 0 ok · 1 error · 2 usage · 3 backend down · 4 refused/denied
"""
import glob, json, os, pathlib, shutil, subprocess, sys, time, urllib.error, urllib.request

BASE = "http://127.0.0.1:8778"
HOME = pathlib.Path(os.environ.get("AIOS_HOME", pathlib.Path.home() / "aios"))
D, B, R, G, Y, C, M, RST = "\033[2m", "\033[1m", "\033[31m", "\033[32m", "\033[33m", "\033[36m", "\033[35m", "\033[0m"
JSON = "--json" in sys.argv
if JSON or not sys.stdout.isatty():
    D = B = R = G = Y = C = M = RST = ""

def die(msg, code=1):
    print(f"{R}✗ {msg}{RST}", file=sys.stderr); sys.exit(code)

def api(path, data=None, timeout=15, method=None):
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(BASE + path, data=body, method=method or ("POST" if body is not None else "GET"),
                                 headers={"Content-Type": "application/json"} if body is not None else {})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        try: msg = json.loads(e.read()).get("detail", str(e))
        except Exception: msg = str(e)
        die(msg, 1)
    except (urllib.error.URLError, ConnectionRefusedError, TimeoutError):
        die("AIOS backend is not running.  Start it:  systemctl --user start aios.service   (ai doctor for details)", 3)

def out(obj, human):
    if JSON: print(json.dumps(obj, indent=2, default=str))
    else: human(obj)

def fmt_bytes(n):
    for u in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024: return f"{n:.1f} {u}" if u != "B" else f"{int(n)} B"
        n /= 1024
    return f"{n:.1f} PB"

# ── streaming (chat / agent) ────────────────────────────────────────────
IMAGES: list = []

def stream(path, message, model, conversation, show_meta=True):
    body = json.dumps({"message": message, "conversation_id": conversation, "model": model,
                       "images": [str(pathlib.Path(i).expanduser().resolve()) for i in IMAGES]}).encode()
    req = urllib.request.Request(BASE + path, data=body, headers={"Content-Type": "application/json"})
    pending = None
    try:
        with urllib.request.urlopen(req, timeout=None) as resp:
            event = "message"
            for raw in resp:
                line = raw.decode().rstrip("\n")
                if line.startswith("event: "): event = line[7:].strip(); continue
                if not line.startswith("data: "): continue
                data = line[6:]; this, event = event, "message"
                if data == "{}": continue
                v = json.loads(data)
                if this == "meta":
                    if show_meta:
                        badge = {"LOCAL": G, "CLOUD": M}.get(v.get("mode"), Y)
                        print(f"{D}[{badge}{v.get('mode')}{RST}{D} · {v.get('model')} · {v.get('task', '')}"
                              + (f" · {v.get('reason')}" if v.get("auto") or path == "/api/agent" else "") + f"]{RST}")
                elif this == "step":
                    print(f"{D}  ↳ {v.get('stage')}: {v.get('msg')}{RST}")
                elif this == "pending":
                    pending = v
                elif this == "error":
                    print(f"\n{R}⚠ {v}{RST}")
                elif this == "done":
                    print()
                else:
                    sys.stdout.write(v); sys.stdout.flush()
    except (urllib.error.URLError, ConnectionRefusedError):
        die("AIOS backend is not running.", 3)
    if pending:
        confirm_pending(pending)

def confirm_pending(p):
    print(f"\n{Y}Proposed command needs your confirmation:{RST}\n  {B}$ {p['cmd']}{RST}\n  {D}{p.get('reason', '')}{RST}")
    if not sys.stdin.isatty():
        api("/api/tool/cancel", {"token": p["token"]}); print(f"{D}(not a terminal — cancelled){RST}"); return
    try: ans = input(f"{Y}Run it? [y/N] {RST}").strip().lower()
    except (EOFError, KeyboardInterrupt): ans = ""
    if ans in ("y", "yes"):
        r = api("/api/tool/exec", {"token": p["token"]}, timeout=120)
        print((f"{G}✓ ran{RST}\n" + r.get("output", "")) if r.get("executed") else f"{R}⚠ {r.get('output')}{RST}")
    else:
        api("/api/tool/cancel", {"token": p["token"]}); print(f"{D}cancelled{RST}")

