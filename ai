    h = api("/api/hardware")
    def human(h):
        c, g, m, b, f = h["cpu"], h["gpu"], h["memory"], h["battery"], h["fans"]
        if section in (None, "system"):
            print(f"{B}{h['model']}{RST} · kernel {h['kernel']} · up {h['uptime_s'] // 3600}h {h['uptime_s'] % 3600 // 60}m")
        if section in (None, "cpu", "system"):
            print(f"{B}CPU{RST}  {c['model']}\n     {c['usage']}% · {c['temp_c']}°C · {c['freq_mhz']} MHz · load {c['load']} · governor {c['governor']} · {c['cores']} threads")
        if section in (None, "gpu", "system"):
            if g.get("present") and not g.get("error"):
                print(f"{B}GPU{RST}  {g['name']}\n     {g['util']}% · VRAM {int(g['vram_used_mb'])}/{int(g['vram_total_mb'])} MB · {g['temp_c']}°C · {g['power_w']} W / {g['power_limit_w']} W · {g['clock_mhz']} MHz · {g['pstate']} · mux: {g['mux_mode']}")
                for p in g["processes"]: print(f"       {p['pid']:>7} {p['name'][:40]:40} {p['vram_mb']} MB")
            else: print(f"{B}GPU{RST}  {g.get('error', 'not present')}")
        if section in (None, "memory", "system"):
            print(f"{B}RAM{RST}  {fmt_bytes(m['used'])} / {fmt_bytes(m['total'])} ({m['percent']}%) · swap {fmt_bytes(m['swap_used'])} / {fmt_bytes(m['swap_total'])}")
        if section in (None, "storage", "system"):
            for fs in h["storage"]["filesystems"]:
                print(f"{B}DISK{RST} {fs['mount']:12} {fmt_bytes(fs['used'])} / {fmt_bytes(fs['size'])} ({fs['percent']}%) free {fmt_bytes(fs['avail'])} · {fs['fs']}" + (f" · nvme {h['storage']['nvme_temp_c']}°C" if fs['mount'] == '/' and h['storage']['nvme_temp_c'] else ""))
        if section in (None, "hardware", "system"):
            print(f"{B}PWR{RST}  battery {b.get('percent')}% {b.get('status', '').lower()} · {b.get('power_w')} W · health {b.get('health_percent') or '?'}% · charge limit {b.get('charge_limit')}% · profile {h['profile']['current']} {h['profile']['choices']}")
            print(f"{B}FAN{RST}  {f.get('rpm')} rpm · mode {f.get('mode')} · {f.get('note', '')}")
            print(f"{B}KBD{RST}  backlight {h['keyboard'].get('level')}/{h['keyboard'].get('max')} · temps {h['temps']} · net ↓{fmt_bytes(h['network']['down_bps'])}/s ↑{fmt_bytes(h['network']['up_bps'])}/s")
    out(h, human)

