def cmd_doctor():
    checks = []
    def add(name, ok, fix=""): checks.append((name, ok, fix))
    try:
        with urllib.request.urlopen(BASE + "/api/status", timeout=3) as r: s = json.loads(r.read()); add("backend reachable on :8778", True)
    except Exception: s = None; add("backend reachable on :8778", False, "systemctl --user start aios.service")
    add("aios.service enabled", subprocess.run(["systemctl", "--user", "is-enabled", "aios.service"], capture_output=True, text=True).stdout.strip() == "enabled", "systemctl --user enable aios.service")
    add("llama-server binary", ((HOME / "llama-server").exists() and os.access(HOME / "llama-server", os.X_OK)) or bool(shutil.which("llama-server")), "sudo pacman -S llama-cpp ggml-vulkan")
    nvidia = any(pathlib.Path(v).read_text().strip() == "0x10de" for v in glob.glob("/sys/bus/pci/devices/*/vendor")
                 if pathlib.Path(v).with_name("class").read_text().startswith("0x03"))
    if nvidia:
        add("nvidia-smi sees the GPU", subprocess.run(["nvidia-smi", "-L"], capture_output=True).returncode == 0, "check the nvidia driver / modules")
    models = sorted(p.parent.name for p in (HOME / "models").glob("*/*.gguf") if "mmproj" not in p.name.lower() and p.stat().st_size > 100_000_000)
    add(f"local models: {', '.join(dict.fromkeys(models)) or 'none'}", bool(models), "praxis-models recommend, then praxis-models download <id>")
    add("python venv", (HOME / ".venv/bin/python").exists())
    for mod in ("fastapi", "httpx", "faster_whisper", "sqlite_vec"):
        add(f"venv has {mod}", subprocess.run([str(HOME / ".venv/bin/python"), "-c", f"import {mod}"], capture_output=True).returncode == 0, f"{HOME}/.venv/bin/pip install {mod.replace('_', '-')}")
    add("quickshell running", subprocess.run(["pgrep", "-x", "quickshell"], capture_output=True).returncode == 0, "praxis-restart-shell  (Super+Esc)")
    add("swaync running", subprocess.run(["pgrep", "-x", "swaync"], capture_output=True).returncode == 0, "swaync &")
    add("polkit agent (for root-only hardware toggles)", subprocess.run(["pgrep", "-f", "polkit-kde-authentication-agent"], capture_output=True).returncode == 0, "/usr/lib/polkit-kde-authentication-agent-1 &")
    add("pw-record (voice)", bool(shutil.which("pw-record")), "pacman -S pipewire")
    add("aios.env is private (0600)", oct((HOME / "config/aios.env").stat().st_mode)[-3:] == "600", f"chmod 600 {HOME}/config/aios.env")
    free = shutil.disk_usage("/").free / 1e9; add(f"disk free {free:.0f} GB", free > 10, "ai cleanup")
    if s: add(f"budget mode {s['budget_mode']}", True); add("internet", s["online"], "local models still work offline")
    ps = api("/api/providers") if s else []
    add(f"cloud providers configured: {sum(1 for p in ps if p['configured'] and p['enabled'])}/{len(ps)}", True, "optional — ai providers")
    bad = 0
    for name, ok, fix in checks:
        print(f"{G + '✓' if ok else R + '✗'}{RST} {name}" + (f"   {D}→ {fix}{RST}" if not ok and fix else "")); bad += not ok
    print(f"\n{G if not bad else Y}{len(checks) - bad}/{len(checks)} checks passed{RST}"); sys.exit(0 if not bad else 1)

def cmd_cleanup(apply):
    cands = []
    for pat in ("*.bak*", "*.orig", "*~"):
        cands += [p for p in HOME.glob(pat)] + [p for p in (HOME / "voice").glob(pat)]
    cands += [p for p in HOME.rglob("__pycache__") if ".venv" not in p.parts and "llama.cpp" not in p.parts]
    cands += list(pathlib.Path.home().joinpath(".config").glob("quickshell.backup.*"))
    cands += list(pathlib.Path.home().joinpath(".config/hypr").glob("hyprland.lua.bak.*"))
    cands += list(pathlib.Path.home().joinpath(".config/swaync").glob("style.css.bak.*"))
    log = HOME / "logs/activity.log"
    if log.exists() and log.stat().st_size > 5e6: cands.append(log)
    def size(p): return sum(f.stat().st_size for f in p.rglob("*") if f.is_file()) if p.is_dir() else p.stat().st_size
    total = 0
    for p in cands:
        sz = size(p); total += sz; print(f"  {fmt_bytes(sz):>10}  {p}")
    print(f"{B}{len(cands)} items · {fmt_bytes(total)}{RST}  {D}(models, llama.cpp build and the DB are never touched){RST}")
    if not cands: return
    if not apply: print(f"{D}run `ai cleanup --apply` to delete them (asks first){RST}"); return
    if "--yes" not in sys.argv:
        try: ans = input(f"{Y}Delete these {len(cands)} items? [y/N] {RST}").strip().lower()
        except (EOFError, KeyboardInterrupt): ans = ""
        if ans not in ("y", "yes"): print("cancelled"); return
    for p in cands:
        shutil.rmtree(p, ignore_errors=True) if p.is_dir() else p.unlink(missing_ok=True)
    print(f"{G}✓ removed {fmt_bytes(total)}{RST}")

