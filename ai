def cmd_do(request):
    r = api("/api/tool/propose", {"request": request}, timeout=240)
    tier = r.get("tier")
    if tier in ("noop", "error"): print(f"{D if tier == 'noop' else R}{r['reason']}{RST}"); sys.exit(0 if tier == "noop" else 1)
    print(f"{D}$ {RST}{B}{r['cmd']}{RST}")
    if tier == "forbidden": print(f"{R}✗ refused — {r['reason']}{RST}"); sys.exit(4)
    if tier == "auto": print(f"{G}✓ ran{RST}" + (f"\n{r['output']}" if r.get("output") else "")); return
    confirm_pending(r)

def cmd_audit():
    for a in api("/api/audit?limit=25"):
        col = {"allow": G, "confirmed": G, "deny": R, "prompt": Y, "cancelled": D}.get(a["decision"], D)
        print(f"{D}{time.strftime('%m-%d %H:%M', time.localtime(a['at']))}{RST} {a['actor']:5} {col}{a['decision']:9}{RST} {a['action'][:80]}")

def cmd_rag(rest):
    """ai rag add PATH | q QUERY [-k N] | stats | embed"""
    if not rest or rest[0] in ("-h", "--help"):
        print("ai rag add <path>          index a file or directory")
        print("ai rag q   \"<query>\" [-k N]  search  (default N=5)")
        print("ai rag stats               index statistics")
        print("ai rag embed               embed pending chunks (needs embedder)")
        return
    sub, args = rest[0], rest[1:]
    if sub == "add":
        if not args: die("ai rag add <path>", 2)
        p = str(pathlib.Path(args[0]).expanduser().resolve())
        r = api("/api/rag/add", {"path": p})
        if JSON: print(json.dumps(r)); return
        print(f"{G}✓{RST} {r.get('files', 0)} file(s), {r.get('chunks', 0)} chunk(s)"
              + (f", {r.get('skipped_count', 0)} skipped" if r.get('skipped_count') else ""))
        for s in r.get('skipped', []): print(f"  {D}- {s}{RST}")
    elif sub == "q":
        k = 5
        if "-k" in args:
            i = args.index("-k"); k = int(args[i + 1]); del args[i:i + 2]
        q = " ".join(args) or die("ai rag q \"<query>\"", 2)
        r = api("/api/rag/query", {"q": q, "k": k})
        if JSON: print(json.dumps(r)); return
        hits = r.get("hits", [])
        if not hits: print(f"{Y}no matches{RST}"); return
        for i, h in enumerate(hits, 1):
            print(f"{B}{i}. {h['title']}{RST}  {D}score={h['score']:.3f}{RST}")
            print(f"   {h['text'][:280].strip()}{'…' if len(h['text']) > 280 else ''}")
            print()
    elif sub == "stats":
        r = api("/api/rag/stats", method="GET")
        if JSON: print(json.dumps(r)); return
        print(f"documents : {r['documents']}")
        print(f"chunks    : {r['chunks']} ({r['embedded']} embedded, {r['vectors']} vectors)")
        print(f"embedder  : {'installed' if r['embedder'] else 'not installed (BM25 only)'}")
    elif sub == "embed":
        r = api("/api/rag/embed")
        if JSON: print(json.dumps(r)); return
        print(f"embedded {r.get('embedded', 0)} chunk(s)")
        if r.get("reason"): print(f"  {D}{r['reason']}{RST}")
    else:
        die(f"unknown rag command: {sub}", 2)

def cmd_forget(rest):
    """ai forget [--all] [--yes] — delete stored memory via the backend."""
    scope = "all" if "--all" in rest else "conversations"
    what = ("EVERYTHING remembered (chats, ingested documents, notes)" if scope == "all"
            else "all stored conversations")
    if "--yes" not in rest and "-y" not in rest:
        if not sys.stdin.isatty():
            die("refusing to forget without --yes in a non-interactive shell", 2)
        ans = input(f"Forget {what}?\n(settings, permissions, audit log and usage ledger are kept) [y/N] ")
        if ans.strip().lower() not in ("y", "yes"):
            print("aborted — nothing deleted"); return
    r = api("/api/memory/forget", {"scope": scope})
    if JSON: print(json.dumps(r)); return
    print(f"{G}✓{RST} forgot {r['objects']} object(s) and {r['chunks']} chunk(s)  {D}(scope: {scope}){RST}")

def cmd_code(text, model):
    ctx = []
    cwd = pathlib.Path.cwd()
    try:
        ls = subprocess.run(["git", "ls-files"], capture_output=True, text=True, timeout=3, cwd=cwd)
        files = (ls.stdout if ls.returncode == 0 else "\n".join(sorted(p.name for p in cwd.iterdir())[:60])).split("\n")
        ctx.append(f"Working directory: {cwd}\nFiles: " + ", ".join(f for f in files if f)[:1500])
        st = subprocess.run(["git", "status", "--short"], capture_output=True, text=True, timeout=3, cwd=cwd)
        if st.returncode == 0 and st.stdout.strip(): ctx.append("git status:\n" + st.stdout[:800])
    except Exception: pass
    prompt = text + "\n\n<project_context>\n" + "\n".join(ctx) + "\n</project_context>"
    stream("/api/chat", prompt, model or "local-coder-7b", "cli-code-" + str(int(time.time())))

def main():
    argv = [a for a in sys.argv[1:] if a != "--json"]
    model = None
    if "--model" in argv:
        i = argv.index("--model"); model = argv[i + 1] if i + 1 < len(argv) else die("--model <id>", 2); del argv[i:i + 2]
    if "--auto" in argv: argv.remove("--auto"); model = "auto"
    while "--image" in argv:
        i = argv.index("--image"); IMAGES.append(argv[i + 1] if i + 1 < len(argv) else die("--image <file>", 2)); del argv[i:i + 2]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__); return
    sub, rest = argv[0], argv[1:]
    conv = "cli-" + str(int(time.time()))
    if sub == "ask":      stream("/api/chat", " ".join(rest) or die("ai ask \"…\"", 2), model or "auto", conv)
    elif sub == "see":
        if not rest: die("ai see <image> [question]", 2)
        IMAGES.append(rest[0]); stream("/api/chat", " ".join(rest[1:]) or "Describe this image in detail.", model or "auto", conv)
    elif sub == "code":   cmd_code(" ".join(rest) or die("ai code \"…\"", 2), model)
    elif sub == "model":  cmd_model(rest)
    elif sub == "models": cmd_models()
    elif sub == "providers": (api("/api/providers/reload") and print(f"{G}✓ reloaded{RST}")) if rest[:1] == ["reload"] else cmd_providers()
    elif sub == "usage":  cmd_usage()
    elif sub == "status": cmd_status()
    elif sub in ("logs", "activity"): cmd_logs(follow=("-f" in rest or "--follow" in rest))
    elif sub == "system": cmd_hw("system")
    elif sub == "hardware":
        if rest[:1] == ["set"] and len(rest) >= 3: cmd_hw_set(rest[1], rest[2])
        else: cmd_hw(None)
    elif sub in ("gpu", "cpu", "memory", "storage"): cmd_hw(sub)
    elif sub == "services": cmd_services()
    elif sub == "voice":  cmd_voice(rest)
    elif sub == "config": cmd_config(rest)
    elif sub == "doctor": cmd_doctor()
    elif sub == "update": cmd_update()
    elif sub == "cleanup": cmd_cleanup(apply="--apply" in rest)
    elif sub == "audit":  cmd_audit()
    elif sub == "do":     cmd_do(" ".join(rest) or die("ai do \"open firefox\"", 2))
    elif sub == "approve": api("/api/settings/approve", {"run_key": "next"}); print(f"{G}✓ next paid request approved{RST}")
    elif sub == "rag":    cmd_rag(rest)
    elif sub == "forget": cmd_forget(rest)
    elif sub == "budget": cmd_config(["budget"] + rest)
    else:
        # bare question → agent when it's about the machine, chat otherwise
        stream("/api/ask", " ".join(argv), model or "auto", conv)

if __name__ == "__main__":
    try: main()
    except KeyboardInterrupt: print(); sys.exit(130)
