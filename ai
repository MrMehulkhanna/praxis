def cmd_logs(follow):
    if follow:
        req = urllib.request.Request(BASE + "/api/activity/stream")
        try:
            with urllib.request.urlopen(req, timeout=None) as resp:
                ev = "message"
                for raw in resp:
                    line = raw.decode().rstrip("\n")
                    if line.startswith("event: "): ev = line[7:].strip(); continue
                    if not line.startswith("data: "): continue
                    d = json.loads(line[6:]); this, ev = ev, "message"
                    if this == "jobs": continue
                    print_event(d)
        except KeyboardInterrupt: print()
        except urllib.error.URLError: die("backend not running", 3)
        return
    a = api("/api/activity?limit=60")
    out(a, lambda a: [print_event(e) for e in a["events"]])

def print_event(e):
    col = {"error": R, "refused": R, "result": G, "executed": G, "approval": Y, "routed": C, "classified": C}.get(e["stage"], D)
    print(f"{D}{time.strftime('%H:%M:%S', time.localtime(e['ts']))}{RST} {D}[{e.get('job') or '-':8}]{RST} {col}{e['stage']:10}{RST} {e['msg']}")

