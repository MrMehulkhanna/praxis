[Unit]
Description=AIOS — local-first AI backend for Praxis
After=graphical-session.target
# Until aios-setup has installed the backend into ~/aios, skip quietly instead of
# failing and restarting every 3 s (live session, or a fresh install before setup).
ConditionPathExists=%h/aios/run.sh

[Service]
Type=simple
ExecStart=%h/aios/run.sh
Restart=on-failure
RestartSec=3
# keep the desktop responsive: the backend and llama-server never starve the compositor
Nice=5

[Install]
WantedBy=default.target
