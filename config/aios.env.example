# AIOS configuration — copy to aios.env, fill in, then `chmod 600 aios.env`.
# The real aios.env is gitignored; it holds your provider keys.

# ── Budget / cost mode ──────────────────────────────────────────────────────
# ZERO_COST    : no paid provider calls ever (default — nothing leaves your machine)
# LOCAL_ONLY   : alias of ZERO_COST
# FREE_ONLINE  : local + cloud models flagged "free" (no-cost tiers)
# APPROVAL     : paid calls need a one-time confirm each
# UNRESTRICTED : paid calls allowed (keys required)
AIOS_BUDGET_MODE=ZERO_COST

# ── Model idle timeout (seconds of silence before VRAM is released) ─────────
AIOS_IDLE_UNLOAD=120

# ── Vision model GPU layers (Qwen3-VL on a 6 GB card) ───────────────────────
AIOS_VL_NGL=16

# ── Dolphin V2 8B GPU layers (unfiltered Qwen3 derivative; preserve desktop VRAM) ──
AIOS_DOLPHIN_NGL=24

# ── ports ───────────────────────────────────────────────────────────────────
LLAMA_PORT=8779
AIOS_PORT=8778

# ── Cloud providers — only used when BUDGET_MODE is FREE_ONLINE / APPROVAL / UNRESTRICTED ──
# Enable a provider in config/providers.json, then set its key here:
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# GITHUB_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
