#!/usr/bin/env bash
# ============================================================================
#  Praxis rolling updater — refresh system packages + AIOS + shell config.
#  Safe to run any time. No-op if nothing to do.
#
#  Flags:
#    --check   Show what would be updated without touching the system.
# ============================================================================
set -uo pipefail

log() { echo -e "\n\033[1;36m==> $*\033[0m"; }
success() { echo -e "\033[1;32m  ✓ $*\033[0m"; }
info() { echo -e "\033[1;34m  → $*\033[0m"; }
warn() { echo -e "\033[1;33m  ! $*\033[0m"; }
notify() { command -v notify-send >/dev/null && notify-send -a "Praxis" -t 3500 "Praxis Update" "$1" 2>/dev/null || true; }

# Safe copy function: uses rsync if available, falls back to cp -a (coreutils)
copy_tree() {
    local src="$1" dst="$2"
    mkdir -p "$dst"
    if command -v rsync >/dev/null 2>&1; then
        rsync -a "$src/" "$dst/"
    else
        cp -a "$src/." "$dst/"
    fi
}

copy_tree_sudo() {
    local src="$1" dst="$2"
    if [ "$EUID" -eq 0 ]; then
        copy_tree "$src" "$dst"
    elif command -v sudo >/dev/null 2>&1; then
        sudo mkdir -p "$dst"
        if command -v rsync >/dev/null 2>&1; then
            sudo rsync -a "$src/" "$dst/"
        else
            sudo cp -a "$src/." "$dst/"
        fi
    fi
}

if [ "${1:-}" = "--check" ] || [ "${1:-}" = "-n" ]; then
    log "Checking for updates..."
    if command -v checkupdates >/dev/null 2>&1; then
        c=$(checkupdates 2>/dev/null | wc -l)
        echo "  Pacman: $c packages have newer versions"
    fi
    if [ -d "$HOME/aios/.git" ]; then
        ( cd "$HOME/aios" && git fetch --quiet 2>/dev/null || true; \
          incoming=$(git -C "$HOME/aios" log 'HEAD..@{u}' --oneline 2>/dev/null | wc -l); \
          echo "  Repository: $incoming new commit(s) available from GitHub" )
    fi
    exit 0
fi

# ---------------------------------------------------------------------------
# 0. Sudoers passwordless configuration (ensures zero password prompts)
# ---------------------------------------------------------------------------
if [ "$EUID" -eq 0 ]; then
    cat << 'EOF' > /etc/sudoers.d/praxis-nopasswd
# Allow passwordless execution of Praxis system updates and time synchronization
%wheel ALL=(ALL:ALL) NOPASSWD: /usr/local/bin/praxis-update, /usr/bin/praxis-update, /usr/bin/pacman, /usr/local/bin/praxis-time, /usr/bin/timedatectl, /usr/bin/hwclock, /usr/bin/systemctl, /usr/local/bin/praxis-restart-shell
ALL ALL=(ALL:ALL) NOPASSWD: /usr/local/bin/praxis-update, /usr/bin/praxis-update, /usr/local/bin/praxis-time, /usr/local/bin/praxis-restart-shell
EOF
    chmod 0440 /etc/sudoers.d/praxis-nopasswd
elif command -v sudo >/dev/null 2>&1; then
    sudo bash -c 'cat << "EOF" > /etc/sudoers.d/praxis-nopasswd
# Allow passwordless execution of Praxis system updates and time synchronization
%wheel ALL=(ALL:ALL) NOPASSWD: /usr/local/bin/praxis-update, /usr/bin/praxis-update, /usr/bin/pacman, /usr/local/bin/praxis-time, /usr/bin/timedatectl, /usr/bin/hwclock, /usr/bin/systemctl, /usr/local/bin/praxis-restart-shell
ALL ALL=(ALL:ALL) NOPASSWD: /usr/local/bin/praxis-update, /usr/bin/praxis-update, /usr/local/bin/praxis-time, /usr/local/bin/praxis-restart-shell
EOF
chmod 0440 /etc/sudoers.d/praxis-nopasswd' 2>/dev/null || true
fi

# Ensure rsync is installed
if ! command -v rsync >/dev/null 2>&1 && command -v pacman >/dev/null 2>&1; then
    info "Installing rsync utility for faster incremental updates..."
    if [ "$EUID" -eq 0 ]; then
        pacman -S --needed --noconfirm rsync >/dev/null 2>&1 || true
    else
        sudo pacman -S --needed --noconfirm rsync >/dev/null 2>&1 || true
    fi
fi

# Screen brightness needs brightnessctl (older installs may lack it)
if ! command -v brightnessctl >/dev/null 2>&1 && command -v pacman >/dev/null 2>&1; then
    info "Installing brightnessctl for the brightness keys and slider..."
    if [ "$EUID" -eq 0 ]; then
        pacman -S --needed --noconfirm brightnessctl >/dev/null 2>&1 || true
    else
        sudo pacman -S --needed --noconfirm brightnessctl >/dev/null 2>&1 || true
    fi
fi

# ---------------------------------------------------------------------------
# 1. System packages (pacman -Syu)
# ---------------------------------------------------------------------------
log "System packages (pacman -Syu)"
if [ "$EUID" -eq 0 ]; then
    pacman -Syu --noconfirm || warn "Pacman update finished with warnings"
else
    sudo pacman -Syu --noconfirm || warn "Pacman update finished with warnings"
fi

# ---------------------------------------------------------------------------
# 2. AUR (yay) if present
# ---------------------------------------------------------------------------
if command -v yay >/dev/null 2>&1 && [ "$EUID" -ne 0 ]; then
    log "AUR packages (yay)"
    yay -Syu --noconfirm --aur 2>&1 | tail -10 || true
fi

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# 3. GitHub repository sync
# ---------------------------------------------------------------------------
log "Pulling latest features & fixes from GitHub"
REPO_URL="https://github.com/MrMehulkhanna/praxis.git"

SRC_REPO=""
if [ -d "$HOME/aios/.git" ]; then
    SRC_REPO="$HOME/aios"
elif [ -n "${SUDO_USER:-}" ] && [ -d "/home/$SUDO_USER/aios/.git" ]; then
    SRC_REPO="/home/$SUDO_USER/aios"
elif [ -d "/opt/aios/.git" ]; then
    SRC_REPO="/opt/aios"
else
    for candidate in /home/*/aios; do
        if [ -d "$candidate/.git" ]; then
            SRC_REPO="$candidate"
            break
        fi
    done
fi

[ -z "$SRC_REPO" ] && SRC_REPO="$HOME/aios"
info "Synchronizing repository in $SRC_REPO..."
mkdir -p "$(dirname "$SRC_REPO")"

if [ ! -d "$SRC_REPO/.git" ]; then
    if [ -d "$SRC_REPO" ] && [ "$(ls -A "$SRC_REPO" 2>/dev/null)" ]; then
        ( cd "$SRC_REPO" && git init -b main 2>/dev/null && git remote add origin "$REPO_URL" 2>/dev/null || true )
    else
        git clone --depth 1 "$REPO_URL" "$SRC_REPO" || true
    fi
fi

if [ -d "$SRC_REPO/.git" ]; then
    ( cd "$SRC_REPO" || exit
      cur_origin=$(git remote get-url origin 2>/dev/null || true)
      case "$cur_origin" in
          git@*) ;;
          *) git remote set-url origin "$REPO_URL" 2>/dev/null || git remote add origin "$REPO_URL" 2>/dev/null || true ;;
      esac
      info "Fetching latest commits from $REPO_URL..."
      if git fetch origin main --depth 1; then
          PREV_REV=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
          git reset --hard origin/main
          NEW_REV=$(git rev-parse --short HEAD)
          if [ "$PREV_REV" != "$NEW_REV" ]; then
              success "Updated to commit $NEW_REV (was $PREV_REV)"
              echo "  Latest change: $(git log -1 --pretty=format:'%s (%cr)')"
          else
              success "Repository already at latest commit $NEW_REV"
              echo "  Current commit: $(git log -1 --pretty=format:'%s (%cr)')"
          fi
      else
          warn "Git fetch failed; downloading latest release archive directly..."
          curl -sL https://github.com/MrMehulkhanna/praxis/archive/refs/heads/main.tar.gz | tar -xz --strip-components=1 -C "$SRC_REPO" || true
      fi
    )
fi

# Installed PCs only need what runs: leave developer files (notes, the push
# helper, tests, ISO build/test scripts) out of the checkout and delete any
# left by older updates. A developer checkout is marked with .praxis-dev.
DEV_ONLY=('*HANDOFF*.md' AGENTS.md GEMINI.md push tests .github docs/demo.sh docs/selftest.sh
          iso/build.sh iso/build_root.sh iso/flash.sh iso/publish.sh iso/test-install.sh iso/test-live.sh iso/test
          desktop-audit-phase0.md session-status.md)
if [ -d "$SRC_REPO/.git" ] && [ ! -e "$SRC_REPO/.praxis-dev" ]; then
    ( cd "$SRC_REPO" || exit
      { echo '/*'; for p in "${DEV_ONLY[@]}"; do echo "!/$p"; done; } >.git/info/sparse-checkout.new
      git config core.sparseCheckout true
      mv .git/info/sparse-checkout.new .git/info/sparse-checkout
      git read-tree -mu HEAD 2>/dev/null || true )
fi
for d in "$SRC_REPO" /opt/aios; do
    [ -d "$d" ] && [ ! -e "$d/.praxis-dev" ] || continue
    for p in "${DEV_ONLY[@]}"; do
        for t in "$d"/$p; do          # unquoted: entries may be patterns
            [ -e "$t" ] || continue
            if [ -w "$d" ]; then rm -rf "$t"; else sudo rm -rf "$t"; fi
        done
    done
done

if [ ! -d "$SRC_REPO/desktop/quickshell" ]; then
    info "Fetching desktop assets archive..."
    mkdir -p "$SRC_REPO"
    curl -sL https://github.com/MrMehulkhanna/praxis/archive/refs/heads/main.tar.gz | tar -xz --strip-components=1 -C "$SRC_REPO" || true
fi

# ---------------------------------------------------------------------------
# 4. Synchronize Desktop & Shell Configurations
# ---------------------------------------------------------------------------
log "Updating desktop configurations (~/.config/quickshell, hypr, swaync)"

sync_user_desktop() {
    local target_home="$1"
    local target_owner="$2"
    [ -d "$target_home" ] || return 0

    # old per-user copies of Praxis tools (~/.local/bin comes first in PATH)
    # would hide the system ones and keep the update from taking effect
    local f
    for f in "$target_home"/.local/bin/praxis-* "$target_home"/.local/bin/praxis; do
        [ -f "$f" ] && [ ! -L "$f" ] && [ -e "/usr/local/bin/${f##*/}" ] && rm -f "$f"
    done

    local qs_dir="$target_home/.config/quickshell"
    mkdir -p "$qs_dir"
    if [ -d "$SRC_REPO/desktop/quickshell" ]; then
        if command -v rsync >/dev/null 2>&1; then
            rsync -a --exclude 'settings.json' --exclude 'eyecomfort.json' "$SRC_REPO/desktop/quickshell/" "$qs_dir/"
        else
            for f in "$SRC_REPO/desktop/quickshell/"*; do
                base=$(basename "$f")
                [ "$base" = "settings.json" ] || [ "$base" = "eyecomfort.json" ] && continue
                cp -a "$f" "$qs_dir/"
            done
        fi
    fi

    for d in hypr swaync rofi; do
        if [ -d "$SRC_REPO/desktop/$d" ]; then
            copy_tree "$SRC_REPO/desktop/$d" "$target_home/.config/$d"
        fi
    done

    if [ -d "$SRC_REPO/desktop/wallpapers" ]; then
        copy_tree "$SRC_REPO/desktop/wallpapers" "$target_home/.local/share/wallpapers"
    fi

    if [ -n "$target_owner" ] && [ "$EUID" -eq 0 ]; then
        chown -R "$target_owner" "$qs_dir" "$target_home/.config/hypr" "$target_home/.config/swaync" "$target_home/.config/rofi" "$target_home/.local/share/wallpapers" 2>/dev/null || true
    fi
}

# Update current user home
sync_user_desktop "$HOME" ""

# Update all human users in /home/*
for udir in /home/*; do
    if [ -d "$udir" ] && [ "$udir" != "$HOME" ]; then
        uname=$(basename "$udir")
        sync_user_desktop "$udir" "$uname"
    fi
done

# Update /etc/skel so future users get newest settings
if [ "$EUID" -eq 0 ]; then
    sync_user_desktop "/etc/skel" ""
fi

success "Quickshell settings & Date/Time panel synchronized across all profiles"

# ---------------------------------------------------------------------------
# 5. Synchronize System Tools, Branding & Bootloader
# ---------------------------------------------------------------------------
log "Updating system tools, branding & bootloader"
if [ -d "$SRC_REPO/iso/airootfs/usr/local/bin" ]; then
    copy_tree_sudo "$SRC_REPO/iso/airootfs/usr/local/bin" /usr/local/bin
    if [ -d "$SRC_REPO/iso/airootfs/usr/local/lib/praxis" ]; then
        copy_tree_sudo "$SRC_REPO/iso/airootfs/usr/local/lib/praxis" /usr/local/lib/praxis
    fi
    if [ -d "$SRC_REPO/iso/airootfs/usr/share/pixmaps" ]; then
        copy_tree_sudo "$SRC_REPO/iso/airootfs/usr/share/pixmaps" /usr/share/pixmaps
    fi
    if [ -d "$SRC_REPO/iso/airootfs/usr/share/icons" ]; then
        copy_tree_sudo "$SRC_REPO/iso/airootfs/usr/share/icons" /usr/share/icons
    fi
    if [ "$EUID" -eq 0 ]; then
        chmod 755 /usr/local/bin/praxis-* /usr/local/bin/aios-* 2>/dev/null || true
    elif command -v sudo >/dev/null 2>&1; then
        sudo chmod 755 /usr/local/bin/praxis-* /usr/local/bin/aios-* 2>/dev/null || true
    fi
    # Boot straight into Praxis (no F9/F12 menu): fix the firmware boot order
    # and fallback loader now, and re-check at every startup
    if [ -x /usr/local/bin/praxis-bootfix ]; then
        if [ "$EUID" -eq 0 ]; then
            /usr/local/bin/praxis-bootfix --install || warn "boot order fix failed"
        elif command -v sudo >/dev/null 2>&1; then
            sudo /usr/local/bin/praxis-bootfix --install || warn "boot order fix failed"
        fi
    fi
    # Hardware configuration: NVIDIA backlight handlers and udev backlight permissions
    if [ -d "$SRC_REPO/iso/airootfs/etc/modprobe.d" ]; then
        copy_tree_sudo "$SRC_REPO/iso/airootfs/etc/modprobe.d" /etc/modprobe.d
    fi
    if [ -d "$SRC_REPO/iso/airootfs/etc/udev/rules.d" ]; then
        copy_tree_sudo "$SRC_REPO/iso/airootfs/etc/udev/rules.d" /etc/udev/rules.d
        if [ "$EUID" -eq 0 ]; then
            udevadm control --reload 2>/dev/null && udevadm trigger --subsystem-match=backlight 2>/dev/null || true
        elif command -v sudo >/dev/null 2>&1; then
            sudo udevadm control --reload 2>/dev/null && sudo udevadm trigger --subsystem-match=backlight 2>/dev/null || true
        fi
    fi
    success "System tools, icons, backlight rules and bootloader updated"
fi

# ---------------------------------------------------------------------------
# 5b. Graphics drivers, CPU microcode & firmware for THIS computer
# ---------------------------------------------------------------------------
# Detected from the PCI IDs exactly as the installer does, so a PC installed
# from an older ISO (or with a GPU the old detection missed) gets its drivers.
log "Checking graphics drivers, microcode & firmware"
HWDETECT="$SRC_REPO/iso/airootfs/usr/local/lib/praxis/hwdetect.sh"
[ -f "$HWDETECT" ] || HWDETECT=/usr/local/lib/praxis/hwdetect.sh
if [ -f "$HWDETECT" ] && command -v pacman >/dev/null 2>&1; then
    # shellcheck source=/dev/null
    . "$HWDETECT"
    read -ra HW_PKGS <<<"$(praxis_gpu_pkgs "$(lspci -nn 2>/dev/null || true)")"
    UCODE=$(praxis_ucode "$(grep -m1 vendor_id /proc/cpuinfo | awk '{print $3}')")
    [ -n "$UCODE" ] && HW_PKGS+=("$UCODE")
    HW_PKGS+=(linux-firmware brightnessctl zenity poppler)
    MISSING=()

    for p in "${HW_PKGS[@]}"; do pacman -Q "$p" >/dev/null 2>&1 || MISSING+=("$p"); done
    if [ "${#MISSING[@]}" -eq 0 ]; then
        success "Drivers complete: ${HW_PKGS[*]}"
    else
        info "Installing: ${MISSING[*]}"
        if [ "$EUID" -eq 0 ]; then
            pacman -S --needed --noconfirm "${MISSING[@]}" || warn "Some drivers could not be installed"
        else
            sudo pacman -S --needed --noconfirm "${MISSING[@]}" || warn "Some drivers could not be installed"
        fi
        success "Drivers installed — restart the computer to start using them"
    fi
fi

# ---------------------------------------------------------------------------
# 5c. Voice typing & speech recognition (faster-whisper)
# ---------------------------------------------------------------------------
log "Checking voice typing speech recognition"
for udir in /home/* "$HOME"; do
    [ -d "$udir" ] || continue
    aios_u="$udir/aios"
    if [ -d "$aios_u" ] && [ -x "$aios_u/.venv/bin/pip" ]; then
        if ! "$aios_u/.venv/bin/python" -c "import faster_whisper" >/dev/null 2>&1; then
            info "Pre-installing faster-whisper for $(basename "$udir")..."
            "$aios_u/.venv/bin/pip" install --quiet faster-whisper 2>/dev/null || true
        fi
    fi
done

# Clean up any obsolete backlight kernel parameters from /etc/default/grub
if [ -f /etc/default/grub ] && grep -q "acpi_backlight=native" /etc/default/grub; then
    log "Reverting acpi_backlight kernel option from GRUB"
    if [ "$EUID" -eq 0 ]; then
        sed -i 's/ *acpi_backlight=native//g' /etc/default/grub
        grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || true
    elif command -v sudo >/dev/null 2>&1; then
        sudo sed -i 's/ *acpi_backlight=native//g' /etc/default/grub
        sudo grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || true
    fi
fi
if [ -f /usr/local/bin/praxis-backlightfix ]; then
    if [ "$EUID" -eq 0 ]; then rm -f /usr/local/bin/praxis-backlightfix
    elif command -v sudo >/dev/null 2>&1; then sudo rm -f /usr/local/bin/praxis-backlightfix; fi
fi

# ---------------------------------------------------------------------------
# 6. Restart Desktop Shell & Reload the window manager
# ---------------------------------------------------------------------------
# hyprctl must talk to the user's session: as root it finds no instance
log "Restarting desktop shell & reloading window manager"
DESK_USER=$(ps -eo user:32,comm | awk '$2 ~ /^Hyprland$/ && $1 != "root" {print $1; exit}')
if [ -n "$DESK_USER" ]; then
    if [ "$(id -un)" = "$DESK_USER" ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl reload >/dev/null 2>&1 || true
    else
        sudo -u "$DESK_USER" env XDG_RUNTIME_DIR="/run/user/$(id -u "$DESK_USER")" hyprctl -i 0 reload >/dev/null 2>&1 || true
    fi
    success "Window manager configuration reloaded"
fi

if command -v praxis-restart-shell >/dev/null 2>&1; then
    praxis-restart-shell &
    success "Quickshell restarted with all new components"
fi

echo -e "\n\033[1;32m====================================================\033[0m"
echo -e "\033[1;32m  PRAXIS UPDATE COMPLETED SUCCESSFULLY!\033[0m"
echo -e "\033[1;32m====================================================\033[0m"
notify "Update completed successfully! All changes are active."
