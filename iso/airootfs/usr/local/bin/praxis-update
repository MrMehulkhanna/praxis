#!/usr/bin/env bash
# ============================================================================
#  Praxis rolling updater — refresh system packages + AIOS + shell config.
#  Safe to run any time. No-op if nothing to do.
#
#  Flags:
#    --check   Show what would be updated without touching the system.
# ============================================================================
set -uo pipefail

log() { echo -e "\n\033[1;36m==> $*\033[0m"; }
success() { echo -e "\033[1;32m  ✓ $*\033[0m"; }
info() { echo -e "\033[1;34m  → $*\033[0m"; }
warn() { echo -e "\033[1;33m  ! $*\033[0m"; }
notify() { command -v notify-send >/dev/null && notify-send -a "Praxis" -t 3500 "Praxis Update" "$1" 2>/dev/null || true; }

# Safe copy function: uses rsync if available, falls back to cp -a (coreutils)
copy_tree() {
    local src="$1" dst="$2"
    mkdir -p "$dst"
    if command -v rsync >/dev/null 2>&1; then
        rsync -a "$src/" "$dst/"
    else
        cp -a "$src/." "$dst/"
    fi
}

copy_tree_sudo() {
    local src="$1" dst="$2"
    if [ "$EUID" -eq 0 ]; then
        copy_tree "$src" "$dst"
    elif command -v sudo >/dev/null 2>&1; then
        sudo mkdir -p "$dst"
        if command -v rsync >/dev/null 2>&1; then
            sudo rsync -a "$src/" "$dst/"
        else
            sudo cp -a "$src/." "$dst/"
        fi
    fi
}

if [ "${1:-}" = "--check" ] || [ "${1:-}" = "-n" ]; then
    log "Checking for updates..."
    if command -v checkupdates >/dev/null 2>&1; then
        c=$(checkupdates 2>/dev/null | wc -l)
        echo "  Pacman: $c packages have newer versions"
    fi
    if [ -d "$HOME/aios/.git" ]; then
        ( cd "$HOME/aios" && git fetch --quiet 2>/dev/null || true; \
          incoming=$(git -C "$HOME/aios" log 'HEAD..@{u}' --oneline 2>/dev/null | wc -l); \
          echo "  Repository: $incoming new commit(s) available from GitHub" )
    fi
    exit 0
fi

# ---------------------------------------------------------------------------
# 0. Sudoers passwordless configuration (runs once to eliminate future prompts)
# ---------------------------------------------------------------------------
if [ ! -f /etc/sudoers.d/praxis-nopasswd ] && command -v sudo >/dev/null 2>&1; then
    info "Configuring passwordless update permissions in /etc/sudoers.d/..."
    sudo bash -c 'cat << "EOF" > /etc/sudoers.d/praxis-nopasswd
%wheel ALL=(ALL:ALL) NOPASSWD: /usr/local/bin/praxis-update, /usr/bin/pacman, /usr/local/bin/praxis-time, /usr/bin/timedatectl, /usr/bin/hwclock, /usr/bin/systemctl restart systemd-timesyncd
ALL ALL=(ALL:ALL) NOPASSWD: /usr/local/bin/praxis-update, /usr/local/bin/praxis-time
EOF
chmod 0440 /etc/sudoers.d/praxis-nopasswd' 2>/dev/null || true
fi

# Ensure rsync is installed
if ! command -v rsync >/dev/null 2>&1 && command -v pacman >/dev/null 2>&1; then
    info "Installing rsync utility for faster incremental updates..."
    if [ "$EUID" -eq 0 ]; then
        pacman -S --needed --noconfirm rsync >/dev/null 2>&1 || true
    else
        sudo pacman -S --needed --noconfirm rsync >/dev/null 2>&1 || true
    fi
fi

# ---------------------------------------------------------------------------
# 1. System packages (pacman -Syu)
# ---------------------------------------------------------------------------
log "System packages (pacman -Syu)"
if [ "$EUID" -eq 0 ]; then
    pacman -Syu --noconfirm || warn "Pacman update finished with warnings"
else
    sudo pacman -Syu --noconfirm || warn "Pacman update finished with warnings"
fi
SYS_RC=$?

# ---------------------------------------------------------------------------
# 2. AUR (yay) if present
# ---------------------------------------------------------------------------
if command -v yay >/dev/null 2>&1 && [ "$EUID" -ne 0 ]; then
    log "AUR packages (yay)"
    yay -Syu --noconfirm --aur 2>&1 | tail -10 || true
fi

# ---------------------------------------------------------------------------
# 3. GitHub repository sync (~/aios)
# ---------------------------------------------------------------------------
log "Pulling latest features & fixes from GitHub"
REPO_URL="https://github.com/MrMehulkhanna/praxis.git"

if [ ! -d "$HOME/aios/.git" ]; then
    if [ -d "$HOME/aios" ]; then
        info "Configuring git tracking in $HOME/aios..."
        ( cd "$HOME/aios" && git init -b main 2>/dev/null && git remote add origin "$REPO_URL" 2>/dev/null || true )
    else
        info "Cloning latest Praxis repository into $HOME/aios..."
        git clone "$REPO_URL" "$HOME/aios"
    fi
fi

if [ -d "$HOME/aios/.git" ]; then
    ( cd "$HOME/aios"
      git remote set-url origin "$REPO_URL" 2>/dev/null || true
      info "Fetching latest commits from $REPO_URL..."
      git fetch origin main --quiet || true
      PREV_REV=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
      git reset --hard origin/main
      NEW_REV=$(git rev-parse --short HEAD)
      if [ "$PREV_REV" != "$NEW_REV" ]; then
          success "Updated to commit $NEW_REV (was $PREV_REV)"
          echo "  Latest change: $(git log -1 --pretty=format:'%s (%cr)')"
      else
          success "Repository already at latest commit $NEW_REV"
          echo "  Current commit: $(git log -1 --pretty=format:'%s (%cr)')"
      fi
    )
fi

# ---------------------------------------------------------------------------
# 4. Synchronize Desktop & Shell Configurations
# ---------------------------------------------------------------------------
log "Updating desktop configurations (~/.config/quickshell, hypr, swaync)"
if [ -d "$HOME/aios/desktop/quickshell" ]; then
    mkdir -p "$HOME/.config/quickshell"
    if command -v rsync >/dev/null 2>&1; then
        rsync -a --exclude 'settings.json' --exclude 'eyecomfort.json' "$HOME/aios/desktop/quickshell/" "$HOME/.config/quickshell/"
    else
        # copy files preserving custom settings.json
        for f in "$HOME/aios/desktop/quickshell/"*; do
            base=$(basename "$f")
            [ "$base" = "settings.json" ] || [ "$base" = "eyecomfort.json" ] && continue
            cp -a "$f" "$HOME/.config/quickshell/"
        done
    fi
    success "Quickshell settings & Date/Time panel synchronized"
fi

for d in hypr swaync rofi; do
    if [ -d "$HOME/aios/desktop/$d" ]; then
        copy_tree "$HOME/aios/desktop/$d" "$HOME/.config/$d"
        success "$d configuration synchronized"
    fi
done

if [ -d "$HOME/aios/desktop/wallpapers" ]; then
    copy_tree "$HOME/aios/desktop/wallpapers" "$HOME/.local/share/wallpapers"
    success "Wallpapers synchronized"
fi

# ---------------------------------------------------------------------------
# 5. Synchronize System Tools, Branding & Bootloader
# ---------------------------------------------------------------------------
log "Updating system tools, branding & bootloader"
if [ -d "$HOME/aios/iso/airootfs/usr/local/bin" ]; then
    copy_tree_sudo "$HOME/aios/iso/airootfs/usr/local/bin" /usr/local/bin
    if [ -d "$HOME/aios/iso/airootfs/usr/local/lib/praxis" ]; then
        copy_tree_sudo "$HOME/aios/iso/airootfs/usr/local/lib/praxis" /usr/local/lib/praxis
    fi
    if [ -d "$HOME/aios/iso/airootfs/usr/share/pixmaps" ]; then
        copy_tree_sudo "$HOME/aios/iso/airootfs/usr/share/pixmaps" /usr/share/pixmaps
    fi
    if [ -d "$HOME/aios/iso/airootfs/usr/share/icons" ]; then
        copy_tree_sudo "$HOME/aios/iso/airootfs/usr/share/icons" /usr/share/icons
    fi
    if [ "$EUID" -eq 0 ]; then
        chmod 755 /usr/local/bin/praxis-* /usr/local/bin/aios-* 2>/dev/null || true
    elif command -v sudo >/dev/null 2>&1; then
        sudo chmod 755 /usr/local/bin/praxis-* /usr/local/bin/aios-* 2>/dev/null || true
    fi
    # Update EFI fallback loader if EFI system is mounted
    if [ -d /boot/efi/EFI/Praxis ] && [ -d /boot/efi/EFI/BOOT ]; then
        if [ "$EUID" -eq 0 ]; then
            cp /boot/efi/EFI/Praxis/grubx64.efi /boot/efi/EFI/BOOT/BOOTX64.EFI 2>/dev/null || true
        elif command -v sudo >/dev/null 2>&1; then
            sudo cp /boot/efi/EFI/Praxis/grubx64.efi /boot/efi/EFI/BOOT/BOOTX64.EFI 2>/dev/null || true
        fi
    fi
    success "System tools, icons, and bootloader updated"
fi

# ---------------------------------------------------------------------------
# 6. Restart Desktop Shell & Reload Hyprland
# ---------------------------------------------------------------------------
log "Restarting desktop shell & reloading Hyprland"
if pgrep -x Hyprland >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || true
    success "Hyprland configuration reloaded"
fi

if command -v praxis-restart-shell >/dev/null 2>&1; then
    praxis-restart-shell &
    success "Quickshell restarted with all new components"
fi

echo -e "\n\033[1;32m====================================================\033[0m"
echo -e "\033[1;32m  PRAXIS UPDATE COMPLETED SUCCESSFULLY!\033[0m"
echo -e "\033[1;32m====================================================\033[0m"
notify "Update completed successfully! All changes are active."
