#!/usr/bin/env bash
# praxis-share — use another machine's screen as a display of this one.
#
#   praxis-share extend [--res WxH@Hz] [--port N] [--no-audio]
#                                                  add a virtual monitor and serve it
#   praxis-share mirror [--output NAME] [--port N]  serve an existing monitor instead
#   praxis-share connect HOST[:PORT]                show a served screen on this machine
#   praxis-share input host [--side right]          share this keyboard and mouse
#   praxis-share input join HOST                    take this machine's input from HOST
#   praxis-share input stop                         stop sharing input
#   praxis-share stop                               stop serving, remove the virtual monitor
#   praxis-share status                             what is being served, and to whom
#   praxis-share doctor                             what is missing before this will work
#
# Extend vs mirror is a real distinction here. `mirror` sends a copy of a
# monitor you already have. `extend` asks Hyprland for a headless output,
# which it treats as a genuine third display with its own workspaces — so
# laptop panel, plugged-in monitor and a remote laptop can all be separate
# screens at once.
#
# On latency: capture -> encode -> network -> decode -> present costs roughly
# 15-40 ms on a good LAN, and this reports the measured figure rather than
# claiming otherwise. That is comfortable for a browser, a terminal or
# reference material on the far screen. It is not good enough for games or
# scrubbing video there, and no amount of tuning makes a network hop free.
set -euo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/praxis-share"
PID_FILE="$STATE_DIR/capture.pid"
SERVE_PID_FILE="$STATE_DIR/serve.pid"
FIFO="$STATE_DIR/stream.ts"
GATE_PID_FILE="$STATE_DIR/gate.pid"
CODE_FILE="$STATE_DIR/code"
# TEMPORARY while the two-laptop link is being tuned: no pairing code. Both
# sides use this fixed key, so a click on the PC in the list connects with
# nothing to type. The link is still encrypted; it is just open to anyone on
# the same network. Set PRAXIS_SHARE_PIN=1 to bring the four-digit code back.
OPEN_CODE="0000"
new_code() { if [ "${PRAXIS_SHARE_PIN:-0}" = 1 ]; then praxis-share-gate newcode; else echo "$OPEN_CODE"; fi; }
MON_FILE="$STATE_DIR/monitor"
PORT_FILE="$STATE_DIR/port"
DEFAULT_PORT=5920
DEFAULT_RES="1920x1080@60"
WITH_AUDIO=1          # send sound with the picture unless told not to

die()  { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
info() { printf '\033[36m•\033[0m %s\n' "$*"; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$*"; }

need() { command -v "$1" >/dev/null || die "$1 is not installed — run: praxis-share doctor"; }

mkdir -p "$STATE_DIR"

# ── capability check ────────────────────────────────────────────────────
doctor() {
    local missing=0
    printf '\n\033[1mpraxis-share requirements\033[0m\n\n'
    check() {
        if eval "$2" >/dev/null 2>&1; then printf '  \033[32m✓\033[0m %-34s %s\n' "$1" "${3:-}"
        else printf '  \033[31m✗\033[0m %-34s \033[2m%s\033[0m\n' "$1" "${4:-missing}"; missing=1; fi
    }
    check "Hyprland running"         'hyprctl version'
    # These are what the pipeline actually uses. The list used to name
    # matroskamux and pipewiresrc, which it stopped using when capture moved
    # to wf-recorder and the container to mpegts — so it reported things
    # missing that are not needed, and never checked the ones that are.
    check "wf-recorder (capture)"    'command -v wf-recorder'          "" "pacman -S wf-recorder"
    check "ffmpeg (encoding)"        'command -v ffmpeg'               "" "pacman -S ffmpeg"
    check "gstreamer"                'command -v gst-launch-1.0'       "" "pacman -S gstreamer gst-plugins-base"
    check "tcpserversink"            'gst-inspect-1.0 tcpserversink'   "" "pacman -S gst-plugins-base"
    check "tsdemux"                  'gst-inspect-1.0 tsdemux'         "" "pacman -S gst-plugins-bad"
    check "h264parse"                'gst-inspect-1.0 h264parse'       "" "pacman -S gst-plugins-bad"
    check "waylandsink (viewer)"     'gst-inspect-1.0 waylandsink'     "" "pacman -S gst-plugins-bad"
    check "aacparse"                 'gst-inspect-1.0 aacparse'        "" "pacman -S gst-plugins-good"
    check "pulsesink (sound out)"    'gst-inspect-1.0 pulsesink'       "" "pacman -S gst-plugins-good"
    check "h264 decoder"             'gst-inspect-1.0 avdec_h264'      "" "pacman -S gst-libav"
    check "h265 decoder"             'gst-inspect-1.0 avdec_h265'      "" "pacman -S gst-libav"
    check "aac decoder"              'gst-inspect-1.0 avdec_aac'       "" "pacman -S gst-libav"
    check "pairing gate"             'command -v praxis-share-gate'    "" "reinstall praxis"

    local enc=""
    for e in nvh264enc vah264enc x264enc; do
        if gst-inspect-1.0 "$e" >/dev/null 2>&1; then enc="$e"; break; fi
    done
    if [ -n "$enc" ]; then
        printf '  \033[32m✓\033[0m %-34s %s\n' "h264 encoder" "$enc$([ "$enc" = nvh264enc ] && echo '  (hardware, NVENC)')"
    else
        printf '  \033[31m✗\033[0m %-34s \033[2m%s\033[0m\n' "h264 encoder" "pacman -S gst-plugins-bad gst-plugins-ugly"; missing=1
    fi

    printf '\n'
    [ "$missing" -eq 0 ] && ok "ready" || info "install what is marked above, then run this again"
    return 0
}

encoder() {
    # Test-encode, don't just ask ffmpeg what it was built with. ffmpeg lists
    # h264_nvenc on every Arch machine, NVIDIA or not, and even on an NVIDIA
    # laptop it stops working between a driver update and the next reboot.
    # Picking a listed-but-dead encoder killed the capture the moment a viewer
    # connected, so the viewer said "connected" and never showed a picture.
    # libx264 is the software fallback that always works.
    # HEVC 4:4:4 comes first: at 30 Mb/s it measured SSIM 0.997 against a
    # lossless copy on a moving test pattern, where H.264 4:4:4 made about 30%
    # more errors at the same bitrate, and NVIDIA GPUs from Turing on decode
    # it in hardware. The test encode uses the real 4:4:4 settings, because a
    # GPU can encode HEVC and still refuse its 4:4:4 profile.
    local e
    if ffmpeg -hide_banner -loglevel error -f lavfi -i nullsrc=s=256x144:r=30 \
           -frames:v 3 -pix_fmt yuv444p -c:v hevc_nvenc -profile:v rext -f null - >/dev/null 2>&1; then
        echo hevc_nvenc; return
    fi
    for e in h264_nvenc libx264; do
        if ffmpeg -hide_banner -loglevel error -f lavfi -i nullsrc=s=256x144:r=30 \
               -frames:v 3 -c:v "$e" -f null - >/dev/null 2>&1; then
            echo "$e"; return
        fi
    done
    die "no working h264 encoder — run: praxis-share doctor"
}

# Low latency matters more than compression ratio here: a big keyframe gap
# means a late joiner stares at nothing, and lookahead/B-frames trade delay
# for bitrate we do not need on a LAN.
encoder_args() {
    case "$1" in
        # NVENC's tune is an enum of its own (hq/ll/ull/lossless) — it does
        # not take x264's "zerolatency", and rejects the whole encoder when
        # handed it. ull is the ultra-low-latency profile we want here.
        h264_nvenc) echo "preset=p1 tune=ull g=30 rc=cbr b=${SHARE_BITRATE:-30M} profile=high444p colorspace=smpte170m color_primaries=bt709 color_trc=iec61966-2-1 color_range=tv" ;;
        hevc_nvenc) echo "preset=p1 tune=ull g=30 bf=0 rc=cbr b=${SHARE_BITRATE:-30M} profile=rext colorspace=smpte170m color_primaries=bt709 color_trc=iec61966-2-1 color_range=tv" ;;
        h264_vaapi) echo "g=30 b=12M" ;;
        *)          echo "preset=ultrafast tune=zerolatency g=30 b=${SHARE_BITRATE_SW:-16M} colorspace=smpte170m color_primaries=bt709 color_trc=iec61966-2-1 color_range=tv" ;;
    esac
}

monitors() { hyprctl -j monitors 2>/dev/null; }

# The monitor of the default sink is "what this machine is playing". Capturing
# it into the same container as the video is what keeps sound with picture:
# one set of timestamps, one muxer, nothing to drift apart.
default_monitor() {
    local sink; sink=$(pactl get-default-sink 2>/dev/null) || return 1
    [ -n "$sink" ] && echo "${sink}.monitor"
}

serving_pid() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        cat "$PID_FILE"
    elif [ -f "$GATE_PID_FILE" ] && kill -0 "$(cat "$GATE_PID_FILE")" 2>/dev/null; then
        cat "$GATE_PID_FILE"
    fi
}

# ── host: add a virtual monitor ─────────────────────────────────────────
add_headless() {
    local before after new
    before=$(monitors | python3 -c 'import json,sys;print(" ".join(m["name"] for m in json.load(sys.stdin)))')
    hyprctl output create headless >/dev/null || die "Hyprland refused to create a headless output"
    sleep 0.6
    after=$(monitors | python3 -c 'import json,sys;print(" ".join(m["name"] for m in json.load(sys.stdin)))')
    for n in $after; do case " $before " in *" $n "*) ;; *) new="$n" ;; esac; done
    [ -n "${new:-}" ] || die "the headless output did not appear"
    # Hyprland gives a new headless output the default scale of 2, so a
    # 1920x1080 display was really 960x540 stretched — blurry text and huge
    # windows on the far screen. Pin it to scale 1 at the requested mode.
    local res; res=$(cat "$STATE_DIR/res" 2>/dev/null || true); [ -n "$res" ] || res="$DEFAULT_RES"
    hyprctl eval "hl.monitor({ output = \"$new\", mode = \"$res\", position = \"auto\", scale = 1 })" >/dev/null 2>&1 || true
    echo "$new"
}

cmd_extend() {
    local res="$DEFAULT_RES" port="$DEFAULT_PORT"
    while [ $# -gt 0 ]; do case "$1" in
        --res)  res="$2";  shift 2 ;;
        --port) port="$2"; shift 2 ;;
        --no-audio) WITH_AUDIO=0; shift ;;
        --audio) WITH_AUDIO=1; shift ;;
        *) die "unknown option: $1" ;;
    esac; done
    [ -z "$(serving_pid)" ] || die "already serving — stop it first:  praxis-share stop"
    need hyprctl
    mkdir -p "$STATE_DIR"
    echo "extend" > "$STATE_DIR/mode"
    echo "$res" > "$STATE_DIR/res"
    echo "$WITH_AUDIO" > "$STATE_DIR/with_audio"
    echo "$port" > "$PORT_FILE"
    rm -f "$MON_FILE"

    local inner=$(( port + 1000 ))
    local code; code=$(new_code)
    printf '%s\n' "$code" > "$CODE_FILE"; chmod 600 "$CODE_FILE"
    setsid praxis-share-gate serve --listen "$port" --to "$inner" --code "$code" \
        --on-connect "praxis-share on-connect-stream" \
        >"$STATE_DIR/gate.log" 2>&1 &
    echo $! > "$GATE_PID_FILE"
    sleep 1
    if ! kill -0 "$(cat "$GATE_PID_FILE")" 2>/dev/null; then
        die "gate did not start — see $STATE_DIR/gate.log"
    fi
    ok "serving on port $port"
    printf '\n  \033[1mpairing code  %s\033[0m\n' "$code"
    info "extra screen will appear to the right when a viewer connects"
}

cmd_mirror() {
    local out="" port="$DEFAULT_PORT"
    while [ $# -gt 0 ]; do case "$1" in
        --output) out="$2";  shift 2 ;;
        --port)   port="$2"; shift 2 ;;
        --no-audio) WITH_AUDIO=0; shift ;;
        --audio) WITH_AUDIO=1; shift ;;
        *) die "unknown option: $1" ;;
    esac; done
    [ -z "$(serving_pid)" ] || die "already serving — stop it first:  praxis-share stop"
    [ -n "$out" ] || out=$(monitors | python3 -c 'import json,sys;ms=json.load(sys.stdin);print(ms[0]["name"] if ms else "")')
    [ -n "$out" ] || die "no monitor to mirror"
    mkdir -p "$STATE_DIR"
    echo "mirror" > "$STATE_DIR/mode"
    echo "$out" > "$STATE_DIR/mirror_out"
    echo "$WITH_AUDIO" > "$STATE_DIR/with_audio"
    echo "$port" > "$PORT_FILE"
    : > "$MON_FILE"            # nothing to remove on stop: it is a real monitor

    local inner=$(( port + 1000 ))
    local code; code=$(new_code)
    printf '%s\n' "$code" > "$CODE_FILE"; chmod 600 "$CODE_FILE"
    setsid praxis-share-gate serve --listen "$port" --to "$inner" --code "$code" \
        --on-connect "praxis-share on-connect-stream" \
        >"$STATE_DIR/gate.log" 2>&1 &
    echo $! > "$GATE_PID_FILE"
    sleep 1
    if ! kill -0 "$(cat "$GATE_PID_FILE")" 2>/dev/null; then
        die "gate did not start — see $STATE_DIR/gate.log"
    fi
    ok "mirroring $out on port $port"
    printf '\n  \033[1mpairing code  %s\033[0m\n' "$code"
}

cmd_on_connect_stream() {
    # Called by the gate when the first viewer completes TLS handshake
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        return 0
    fi
    local mode; mode=$(cat "$STATE_DIR/mode" 2>/dev/null || echo "extend")
    local mon=""
    # the viewer named its own screen during pairing: build the extra display
    # at exactly that size, so nothing is stretched on the far side
    if [ -n "${PRAXIS_SHARE_RES:-}" ]; then
        echo "$PRAXIS_SHARE_RES" > "$STATE_DIR/res"
        info "viewer screen is $PRAXIS_SHARE_RES"
    fi
    if [ "$mode" = "extend" ]; then
        if [ -s "$MON_FILE" ] && monitors | grep -q "\"$(cat "$MON_FILE")\""; then
            mon=$(cat "$MON_FILE")
            hyprctl eval "hl.monitor({ output = \"$mon\", mode = \"$(cat "$STATE_DIR/res" 2>/dev/null || echo "$DEFAULT_RES")\", position = \"auto\", scale = 1 })" >/dev/null 2>&1 || true
        else
            mon=$(add_headless)
            echo "$mon" > "$MON_FILE"
            ok "added $mon as a new display"
        fi
    else
        mon=$(cat "$STATE_DIR/mirror_out" 2>/dev/null || true)
        [ -n "$mon" ] || mon=$(monitors | python3 -c 'import json,sys;ms=json.load(sys.stdin);print(ms[0]["name"] if ms else "")')
    fi
    # Over Wi-Fi the picture has to fit ~30 Mb/s and live with jitter. Over a
    # cable — Ethernet, or a Thunderbolt/USB4 network link — there is room
    # for three times that, which takes the last of the blockiness out.
    # Decide from the interface the viewer is actually reached through.
    local peer=${PRAXIS_SHARE_PEER:-} dev=""
    [ -n "$peer" ] && dev=$(ip route get "$peer" 2>/dev/null | grep -oE 'dev [^ ]+' | awk '{print $2}' | head -1)
    # Bitrate follows the picture size: 30 Mb/s is near lossless for a
    # 1080p screen, so a 2880x1620 one (2.25x the pixels) gets ~70.
    local res w h px=2073600; res=$(cat "$STATE_DIR/res" 2>/dev/null || true)
    if [[ "$res" =~ ^([0-9]+)x([0-9]+) ]]; then w=${BASH_REMATCH[1]}; h=${BASH_REMATCH[2]}; px=$(( w * h )); fi
    SHARE_BITRATE="$(( (px * 15 + 999999) / 1000000 ))M"
    [ "${SHARE_BITRATE%M}" -lt 30 ] && SHARE_BITRATE=30M
    case "$dev" in
        wl*|"") ;;
        *) SHARE_BITRATE="$(( ${SHARE_BITRATE%M} * 3 > 150 ? 150 : ${SHARE_BITRATE%M} * 3 ))M"; SHARE_BITRATE_SW=40M
           info "wired link to $peer ($dev) — higher quality" ;;
    esac
    local port; port=$(cat "$PORT_FILE" 2>/dev/null || echo "$DEFAULT_PORT")
    # the capture died (or never started): clear its server too, or the old
    # one keeps the loopback port and the new one cannot serve anything
    if [ -f "$SERVE_PID_FILE" ]; then kill "$(cat "$SERVE_PID_FILE")" 2>/dev/null || true; fi
    local with_audio; with_audio=$(cat "$STATE_DIR/with_audio" 2>/dev/null || echo "1")
    WITH_AUDIO="$with_audio"
    start_stream "$mon" "$port"
}

start_stream() {
    local mon="$1" port="$2" fps="${3:-60}" enc
    local inner=$(( port + 1000 ))   # loopback-only; the gate fronts "$port"
    need wf-recorder; need gst-launch-1.0
    enc=$(encoder)
    # Software x264 at 1080p60 costs about three CPU cores; at 30 it is half
    # that and still smooth for documents, browsers and terminals. Hardware
    # encoders keep 60.
    [ "$enc" = libx264 ] && [ "$fps" -gt 30 ] && fps=30
    # NVENC on a laptop RTX 4050 encodes 4:4:4 at ~107 fps for 1920x1080 but
    # only ~49 for 2880x1620. Asking for more than it can do does not drop
    # frames cleanly: they queue, and the queue is input delay. Keep full
    # colour and ask for what the chip sustains, with a little headroom
    # (~200 Mpixel/s), never above 60.
    case "$enc" in *_nvenc)
        local res; res=$(cat "$STATE_DIR/res" 2>/dev/null || true)
        if [[ "$res" =~ ^([0-9]+)x([0-9]+) ]]; then
            local cap=$(( 200000000 / (BASH_REMATCH[1] * BASH_REMATCH[2]) ))
            [ "$cap" -lt "$fps" ] && fps=$cap
            [ "$fps" -lt 30 ] && fps=30
        fi ;;
    esac
    echo "$port" > "$PORT_FILE"

    rm -f "$FIFO"; mkfifo "$FIFO"

    info "capturing $mon with $enc$(case $enc in *_nvenc) echo ' (hardware)';; esac)"
    # each tuning flag needs its own -p, so expand them into an argv array
    local -a pargs=(); local kv
    for kv in $(encoder_args "$enc"); do pargs+=(-p "$kv"); done

    local -a aargs=()
    if [ "$WITH_AUDIO" = 1 ]; then
        local src; src=$(default_monitor || true)
        if [ -n "$src" ]; then
            aargs=(--audio="$src" --audio-backend=pulse -C aac)
            info "audio: $(printf '%s' "$src" | sed 's/^alsa_output\.//; s/\.monitor$//')"
        else
            info "no audio source found — video only"
        fi
    fi

    # Full 4:4:4 colour on the hardware encoder. Ordinary 4:2:0 video keeps a
    # quarter of the colour detail, which is fine for film and smears text,
    # thin lines and coloured edges — measured on a real screenshot, SSIM went
    # from 0.905 (4:2:0, 12 Mb/s) to 0.982 (4:4:4, 30 Mb/s), PSNR 43.8 -> 52 dB.
    # The software fallback stays 4:2:0 to keep its CPU cost down.
    local -a fmtargs=()
    case "$enc" in *_nvenc) fmtargs=(-x yuv444p) ;; esac
    setsid wf-recorder -y -D -o "$mon" -c "$enc" -m mpegts -r "$fps" "${fmtargs[@]}" \
        "${pargs[@]}" "${aargs[@]}" -f "$FIFO" >"$STATE_DIR/capture.log" 2>&1 &
    echo $! > "$PID_FILE"

    # No leaky queue on this side. Dropping part of an H.264 stream corrupts
    # every frame until the next keyframe — the blocky "bursting" picture.
    setsid gst-launch-1.0 -q \
        filesrc location="$FIFO" \
        ! tcpserversink host=127.0.0.1 port="$inner" sync=false \
        >"$STATE_DIR/serve.log" 2>&1 &
    echo $! > "$SERVE_PID_FILE"
}

cmd_connect() {
    local target="" code=""
    while [ $# -gt 0 ]; do case "$1" in
        --code) code="$2"; shift 2 ;;
        *) target="$1"; shift ;;
    esac; done
    [ -n "$target" ] || die "usage: praxis-share connect HOST[:PORT] [--code NNNNNN]"
    local host="${target%%:*}" port="${target##*:}"
    [ "$port" = "$host" ] && port="$DEFAULT_PORT"
    need gst-launch-1.0; need praxis-share-gate

    # Check receiver requirements before connecting so missing plugins are immediately obvious
    local missing=()
    gst-inspect-1.0 tsdemux >/dev/null 2>&1 || missing+=("tsdemux (gst-plugins-bad)")
    gst-inspect-1.0 h264parse >/dev/null 2>&1 || missing+=("h264parse (gst-plugins-bad)")
    gst-inspect-1.0 avdec_h264 >/dev/null 2>&1 || missing+=("avdec_h264 (gst-libav)")
    if [ ${#missing[@]} -gt 0 ]; then
        printf '\n\033[31m✗ This machine is missing media decoders needed to view shared screens:\033[0m\n' >&2
        for m in "${missing[@]}"; do
            printf '  • %s\n' "$m" >&2
        done
        printf '\nTo install them on this machine, run:\n' >&2
        printf '  \033[1;32msudo pacman -S --needed gst-plugins-bad gst-libav gst-plugins-good\033[0m\n\n' >&2
        if [ -t 0 ] || [ -t 1 ]; then
            read -p "Press Enter to exit..." _ || true
        fi
        exit 1
    fi

    local vsink="waylandsink fullscreen=true"
    if [ -z "${WAYLAND_DISPLAY:-}" ] || ! gst-inspect-1.0 waylandsink >/dev/null 2>&1; then
        vsink="autovideosink"
    fi

    local asink="pulsesink"
    if ! gst-inspect-1.0 pulsesink >/dev/null 2>&1; then
        asink="autoaudiosink"
    fi

    [ -z "$code" ] && [ "${PRAXIS_SHARE_PIN:-0}" != 1 ] && code="$OPEN_CODE"
    if [ -z "$code" ]; then
        # asked for rather than guessed: the host is showing it on its screen
        printf 'pairing code shown on %s: ' "$host"
        read -r code
    fi
    [ -n "$code" ] || die "no code given"

    # Auto-correct common subnet octet typo (e.g. typing 10.255 when on 10.225)
    local my_sub
    my_sub=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d. -f1-2 | head -1)
    if [ -n "$my_sub" ] && [[ "$host" =~ ^10\.255\.(.*) ]] && [[ "$my_sub" == 10.* ]] && [[ "$my_sub" != "10.255" ]]; then
        local fixed_host="${my_sub}.${host#10.255.}"
        if (exec 3<>/dev/tcp/"$fixed_host"/"$port") 2>/dev/null; then
            exec 3<&- 3>&-
            info "auto-correcting typo in host address: $host -> $fixed_host"
            host="$fixed_host"
        fi
    fi

    local local_port=$(( port + 2000 ))
    mkdir -p "$STATE_DIR"
    info "connecting to $host:$port"
    # this screen's real pixels and refresh, so the host builds a matching
    # display; capped at 60 Hz, what the encoder is set up for
    local myres; myres=$(monitors | python3 -c 'import json,sys
ms=json.load(sys.stdin); m=next((m for m in ms if m.get("focused")), ms[0] if ms else None)
if m: print("%dx%d@%d" % (m["width"], m["height"], min(60, round(m["refreshRate"]))))' 2>/dev/null || true)
    setsid praxis-share-gate client --host "$host" --port "$port" \
        --listen "$local_port" --code "$code" ${myres:+--res "$myres"} >"$STATE_DIR/client.log" 2>&1 &
    local gate=$!
    sleep 2
    if ! kill -0 "$gate" 2>/dev/null; then
        printf '\n'; sed 's/^/  /' "$STATE_DIR/client.log" 2>/dev/null | tail -3
        die "could not connect"
    fi
    ok "connected — Super+C closes the picture, Super+Alt+D disconnects"

    # The decoder now reads from the authenticated tunnel on loopback, not
    # from the network: everything over the wire is inside the TLS session
    # the pairing code established.
    # BGRx before the sink: handed YUV, the compositor colour-manages the
    # surface as video, which on a wide-gamut panel washed it out next to
    # every other window. As plain RGB it is treated like any other app.
    #
    # Leaky queues and async=false are what make a window appear at all.
    # Where to drop, and where never to: compressed video is never dropped —
    # losing part of it corrupts every frame up to the next keyframe, which
    # showed as blocks bursting across the picture. Only *decoded* frames are
    # dropped, by the one-frame leaky queue after the decoder: harmless, and
    # it means the newest frame is always the one on screen. Slice threading
    # keeps the decoder from holding frames back (frame threading adds a few
    # frames of delay), output-corrupt=false never shows a damaged frame, and
    # the audio branch stays leaky so it can never block the demuxer.
    #
    # 100 ms each: a leaky queue drops the oldest data instead of blocking,
    # so it can be small without bringing back the preroll deadlock, and a
    # 1 s queue had been adding up to a second of input delay.
    # A viewer that joins mid-stream drops video until the next keyframe;
    # meanwhile the small audio queue filled, blocked the demuxer, and the
    # keyframe never arrived — the pipeline sat in PREROLLING forever with
    # no window, while saying "connected".
    #
    # The viewer runs in the background and we wait on it, rather than in the
    # foreground: bash does not run a trap while a foreground child is
    # running, so a Disconnect from the window used to leave the picture up
    # until the stream died on its own. With wait, a signal lands at once.
    echo "$target" > "$STATE_DIR/viewer.target"
    gst-launch-1.0 -q \
        tcpclientsrc host=127.0.0.1 port="$local_port" ! tsdemux name=d latency=0 \
        d. ! queue max-size-buffers=0 max-size-bytes=0 max-size-time=0 \
           ! decodebin3 \
           ! queue leaky=downstream max-size-buffers=1 \
           ! videoconvert ! video/x-raw,format=BGRx ! $vsink sync=false async=false \
        d. ! queue leaky=downstream max-size-buffers=0 max-size-bytes=0 max-size-time=100000000 \
           ! aacparse ! avdec_aac ! audioconvert ! audioresample ! $asink sync=false async=false &
    VIEW_PID=$!; VIEW_GATE=$gate
    echo "$VIEW_GATE $VIEW_PID" > "$STATE_DIR/viewer.pids"
    # globals, not locals: an EXIT trap runs after the function has returned,
    # and under set -u a local it names is unbound by then
    trap 'kill "${VIEW_GATE:-}" "${VIEW_PID:-}" 2>/dev/null || true; rm -f "$STATE_DIR/viewer.pids" "$STATE_DIR/viewer.target"' EXIT INT TERM
    set +e
    wait "$VIEW_PID"
    local rc=$?
    set -e
    if [ "$rc" -ne 0 ] && [ "$rc" -lt 128 ]; then
        printf 'stream viewer stopped (exit %d) — praxis-share doctor\n' "$rc" >&2
        return 1
    fi
}

cmd_disconnect() {
    local f="$STATE_DIR/viewer.pids"
    if [ -s "$f" ]; then
        # shellcheck disable=SC2046
        kill $(cat "$f") 2>/dev/null || true
        rm -f "$f" "$STATE_DIR/viewer.target"
    fi
    pkill -f "gst-launch-1.0.*tcpclientsrc" 2>/dev/null || true
    pkill -f "praxis-share-gate client" 2>/dev/null || true
    cmd_input stop >/dev/null 2>&1 || true
    ok "disconnected"
}

# Every window on the shared display goes back to the main screen, so
# stopping a share never strands a window on a display that is about to go.
cmd_bring_back() {
    local mon; mon=$(cat "$MON_FILE" 2>/dev/null || true)
    [ -n "$mon" ] || { info "no shared display"; return 0; }
    local main; main=$(monitors | python3 -c 'import json,sys
for m in json.load(sys.stdin):
    if not m["name"].startswith("HEADLESS"): print(m["name"]); break')
    local addrs; addrs=$(hyprctl -j clients 2>/dev/null | python3 -c "import json,sys
ws={w['id'] for w in json.loads(__import__('subprocess').run(['hyprctl','-j','workspaces'],capture_output=True,text=True).stdout) if w.get('monitor')=='$mon'}
for c in json.load(sys.stdin):
    if c.get('workspace',{}).get('id') in ws: print(c['address'])")
    local n=0 a
    for a in $addrs; do
        hyprctl dispatch "hl.dsp.window.move({ monitor = \"$main\", window = \"address:$a\" })" >/dev/null 2>&1 && n=$((n+1))
    done
    ok "brought $n window(s) back to $main"
}

cmd_stop() {
    [ -s "$MON_FILE" ] && cmd_bring_back >/dev/null 2>&1 || true
    local pid; pid=$(serving_pid || true)
    if [ -n "$pid" ]; then kill -INT "$pid" 2>/dev/null || true; ok "stopped capturing"; else info "not serving"; fi
    # "|| true" on every kill: under set -e, killing a process that already
    # exited returns 1 and aborted stop on this line — so the gate below it
    # was never killed, kept the old PIN, and every later start said
    # "already serving".
    [ -f "$SERVE_PID_FILE" ] && { kill "$(cat "$SERVE_PID_FILE")" 2>/dev/null || true; }
    [ -f "$GATE_PID_FILE" ] && { kill "$(cat "$GATE_PID_FILE")" 2>/dev/null || true; }
    rm -f "$PID_FILE" "$SERVE_PID_FILE" "$GATE_PID_FILE" "$PORT_FILE" "$CODE_FILE" "$FIFO" "$STATE_DIR/clients.json" "$STATE_DIR/mode" "$STATE_DIR/res" "$STATE_DIR/mirror_out"
    input_running && info "input is still shared — praxis-share input stop"
    if [ -s "$MON_FILE" ]; then
        local mon; mon=$(cat "$MON_FILE")
        hyprctl output remove "$mon" >/dev/null 2>&1 && ok "removed $mon"
    fi
    rm -f "$MON_FILE"
}

cmd_status() {
    local pid; pid=$(serving_pid || true)
    if [ -n "$pid" ]; then
        ok "serving on port $(cat "$PORT_FILE" 2>/dev/null || echo '?')  (pid $pid)"
        [ -s "$MON_FILE" ] && info "virtual display: $(cat "$MON_FILE")"
        [ -s "$CODE_FILE" ] && printf '  pairing code  \033[1m%s\033[0m\n' "$(cat "$CODE_FILE")"
    else
        info "not serving"
    fi
    printf '\n\033[1mdisplays\033[0m\n'
    local out
    if ! out=$(monitors); then
        echo "  (Hyprland not reachable)"; return
    fi
    printf '%s' "$out" | python3 -c '
import json, sys
for m in json.load(sys.stdin):
    name = m["name"]
    kind = "virtual" if name.startswith("HEADLESS") else "physical"
    print("  %-12s %dx%d@%.0f  scale %s  (%s)"
          % (name, m["width"], m["height"], m["refreshRate"], m["scale"], kind))
'
}

# ── keyboard and mouse across machines ──────────────────────────────────
# Separate from the video on purpose. The virtual display is a real output
# of this compositor, so windows moved onto it are already driven by this
# keyboard — nothing to forward. What is missing is the other direction:
# one keyboard and mouse reaching the other machine's own desktop. That is
# what deskflow does, and it needs a screen layout naming both sides.
# -s names the settings file; the screen layout is read from
# deskflow-server.conf sitting beside it, not from -s itself.
DESKFLOW_SETTINGS="$STATE_DIR/deskflow.conf"
DESKFLOW_CONF="$STATE_DIR/deskflow-server.conf"
INPUT_PID_FILE="$STATE_DIR/input.pid"

write_deskflow_conf() {   # here there side
    # Deskflow 1.27 moved the screen list out of the server config and into
    # the settings file; a server config that still declares screens is
    # ignored with a warning, and its links then fail with "unknown computer
    # name". So the neighbours are declared here, in the INI.
    local opposite
    case "$3" in right) opposite=left ;; left) opposite=right ;; up) opposite=down ;; *) opposite=up ;; esac
    cat >"$DESKFLOW_SETTINGS" <<INI
[General]
$3=$2
screenSaverSync=false

[core]
computerName=$1

[log]
level=Info
INI
    cat >"$DESKFLOW_CONF" <<CONF
section: options
    screenSaverSync = false
    switchCorners = none
end
CONF
    printf '%s\n' "$opposite" >/dev/null   # kept for symmetry on the far side
}

input_running() { [ -f "$INPUT_PID_FILE" ] && kill -0 "$(cat "$INPUT_PID_FILE")" 2>/dev/null; }

cmd_input() {
    local sub="${1:-status}"; shift || true
    case "$sub" in
        host)
            local side=right peer=""
            while [ $# -gt 0 ]; do case "$1" in
                --side) side="$2"; shift 2 ;;
                --peer) peer="$2"; shift 2 ;;
                *) die "unknown option: $1" ;;
            esac; done
            command -v deskflow-core >/dev/null || die "deskflow is not installed"
            input_running && die "input is already shared — praxis-share input stop"
            [ -n "$peer" ] || peer="praxis-peer"
            local me; me=$(uname -n)
            write_deskflow_conf "$me" "$peer" "$side"
            setsid deskflow-core server --new-instance -s "$DESKFLOW_SETTINGS" \
                >"$STATE_DIR/input.log" 2>&1 &
            echo $! > "$INPUT_PID_FILE"
            sleep 1.5
            input_running || { tail -4 "$STATE_DIR/input.log" 2>/dev/null; die "deskflow did not start"; }
            ok "sharing this keyboard and mouse — the other machine is to the $side"
            info "on it:  praxis-share input join $(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
            ;;
        join)
            local host="${1:-}"; [ -n "$host" ] || die "usage: praxis-share input join HOST"
            command -v deskflow-core >/dev/null || die "deskflow is not installed"
            input_running && die "already joined — praxis-share input stop"
            setsid deskflow-core client --new-instance "$host" \
                >"$STATE_DIR/input.log" 2>&1 &
            echo $! > "$INPUT_PID_FILE"
            sleep 1.5
            input_running || { tail -4 "$STATE_DIR/input.log" 2>/dev/null; die "could not join $host"; }
            ok "taking keyboard and mouse from $host"
            ;;
        stop)
            if input_running; then kill "$(cat "$INPUT_PID_FILE")" 2>/dev/null; ok "input sharing stopped"
            else info "input is not shared"; fi
            rm -f "$INPUT_PID_FILE"
            ;;
        status|"")
            if input_running; then ok "input is shared (pid $(cat "$INPUT_PID_FILE"))"
            else info "input is not shared"; fi
            ;;
        *) die "unknown: praxis-share input $sub" ;;
    esac
}

case "${1:-}" in
    extend)  shift; cmd_extend "$@" ;;
    mirror)  shift; cmd_mirror "$@" ;;
    connect) shift; cmd_connect "$@" ;;
    input)   shift; cmd_input "$@" ;;
    disconnect) cmd_disconnect ;;
    bring-back) cmd_bring_back ;;
    on-connect-stream) cmd_on_connect_stream ;;
    stop)    cmd_stop ;;
    status)  cmd_status ;;
    scan)    shift; praxis-share-gate scan "$@" ;;
    doctor)  doctor ;;
    ""|-h|--help|help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command: $1  (try: praxis-share help)" ;;
esac
