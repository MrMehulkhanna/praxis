#!/usr/bin/env python3
# ============================================================================
#  praxis-models — hardware-aware local LLM catalog + downloader
#
#  Detects your VRAM/RAM, shows what fits, and downloads with curl (resumable).
#  Includes uncensored / abliterated variants (Dolphin, "Uncensored", etc.)
#  for direct answers without corporate safety refusals — legal, widely
#  distributed on Hugging Face, but they'll be blunt so use responsibly.
#
#  Commands
#  --------
#    praxis-models list                   full catalog
#    praxis-models recommend              only what fits YOUR hardware
#    praxis-models download <id>          fetch and store in ~/aios/models/<id>
#                                         (the AI panel lists it right away)
#    praxis-models remove   <id>          delete the local copy
#    praxis-models installed              show what's already downloaded
#    praxis-models space                  show disk / VRAM budget
# ============================================================================
import argparse, json, os, pathlib, shutil, subprocess, sys, textwrap

HOME = pathlib.Path.home()
MODELS = pathlib.Path(os.environ.get("AIOS_HOME", HOME / "aios")) / "models"
MODELS.mkdir(parents=True, exist_ok=True)

# ── colours (skip when piped) ───────────────────────────────────────────────
