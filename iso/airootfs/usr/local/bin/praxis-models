# ---------------------------------------------------------------------------

def detect_hardware() -> dict:
    """Return a dict of {vram_gb, ram_gb, cpu, gpu_name, disk_free_gb}."""
    hw = {"vram_gb": 0, "ram_gb": 0, "cpu": "", "gpu_name": "", "disk_free_gb": 0}
    # VRAM — NVIDIA via nvidia-smi, AMD via the amdgpu sysfs counter
    try:
        r = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,memory.total", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            name, mib = [x.strip() for x in r.stdout.splitlines()[0].split(",")]
            hw["gpu_name"] = name
            hw["vram_gb"] = round(int(mib) / 1024, 1)
    except (FileNotFoundError, subprocess.SubprocessError, ValueError):
        pass
    if not hw["vram_gb"]:
        for f in sorted(pathlib.Path("/sys/class/drm").glob("card*/device/mem_info_vram_total")):
            try:
                gb = round(int(f.read_text()) / 1024 ** 3, 1)
            except (OSError, ValueError):
                continue
            if gb > hw["vram_gb"]:
                hw["vram_gb"], hw["gpu_name"] = gb, "AMD GPU"
    # RAM
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    hw["ram_gb"] = int(line.split()[1]) // (1024 * 1024)
                    break
    except OSError:
        pass
    # CPU model
    try:
        with open("/proc/cpuinfo") as f:
            for line in f:
                if line.startswith("model name"):
                    hw["cpu"] = line.split(":", 1)[1].strip()
                    break
    except OSError:
        pass
    # Disk free (models dir)
    try:
        s = shutil.disk_usage(str(MODELS))
        hw["disk_free_gb"] = round(s.free / (1024 ** 3), 1)
    except OSError:
        pass
    return hw


def print_hw(hw: dict) -> None:
    print(f"{B}Your machine{X}")
    print(f"  GPU        {hw['gpu_name'] or D+'no dedicated GPU — models run on the CPU (small ones are fine)'+X}")
    print(f"  VRAM       {hw['vram_gb']} GiB")
    print(f"  CPU        {hw['cpu']}")
    print(f"  RAM        {hw['ram_gb']} GiB")
    print(f"  Free disk  {hw['disk_free_gb']} GiB (models dir: {MODELS})")


def catalog_row(m: dict, ok: bool) -> str:
    tags = f"{C}{' '.join(m['tags'])}{X}"
    warn = "" if m["censored"] else f" {Y}·UNCENSORED{X}"
    tick = f"{G}✓{X}" if ok else f"{D}✗{X}"
    return (f"  {tick} {B}{m['id']:<32}{X} {D}{m['size_gb']:.1f} GB · VRAM≥{m['vram_gb']} GB{X}\n"
            f"      {tags}{warn}\n"
            f"      {m['desc']}")


def cmd_list(hw: dict) -> None:
    print_hw(hw); print()
    print(f"{B}Full catalog{X}  ({G}✓{X} = fits your hardware, {D}✗{X} = won't run comfortably)\n")
    for m in CATALOG:
        ok = fits(m, hw)
        print(catalog_row(m, ok))


def fits(m: dict, hw: dict) -> bool:
    """
    A model fits when the GPU has ~its VRAM budget (nvidia-smi under-reports
    total by ~1 GiB after driver overhead, so accept vram-1), or partial-
    offload is viable (RAM covers the whole file with headroom).
    """
    if hw["vram_gb"] + 1 >= m["vram_gb"]:
        return True
    if hw["ram_gb"] >= m["size_gb"] * 2:
        return True
    return False


def cmd_recommend(hw: dict) -> None:
    print_hw(hw); print()
    fits_list = [m for m in CATALOG if fits(m, hw)]
    if not fits_list:
        print(f"{Y}Nothing in the catalog is a comfortable fit for this hardware.{X}")
        print("Try the tiny models with --force, but expect swap thrash.")
        return
    # sort: fitting-with-headroom first, then by size desc
    fits_list.sort(key=lambda m: (-m["size_gb"]))
    print(f"{B}Recommended for your hardware{X}\n")
    for m in fits_list:
        print(catalog_row(m, True))
    print(f"\n{D}Download one with:  praxis-models download <id>{X}")


def cmd_installed() -> None:
    if not MODELS.exists():
        print(f"no models in {MODELS}")
        return
    found = []
    for d in sorted(MODELS.iterdir()):
        if d.is_dir():
            size = sum(f.stat().st_size for f in d.rglob("*") if f.is_file()) / (1024**3)
            found.append((d.name, size))
    if not found:
        print(f"{D}no models installed under {MODELS}{X}")
        return
    print(f"{B}Installed models{X}  {D}({MODELS}){X}\n")
    for n, s in found:
        print(f"  {G}✓{X} {n:<40} {D}{s:.2f} GB{X}")


def cmd_download(model_id: str, hw: dict, force: bool) -> None:
    m = next((x for x in CATALOG if x["id"] == model_id), None)
    if not m:
        die(f"unknown model id: {model_id}. Try: praxis-models list")
    if not fits(m, hw) and not force:
        die(f"{model_id} needs {m['vram_gb']} GB VRAM; you have {hw['vram_gb']} GB. "
            f"Pass --force to try anyway.")
    if hw["disk_free_gb"] and hw["disk_free_gb"] < m["size_gb"] + 1:
        die(f"only {hw['disk_free_gb']} GB free; {model_id} needs {m['size_gb']:.1f} GB + margin.")

    dest = MODELS / m["id"]
    dest.mkdir(parents=True, exist_ok=True)
    files = [m["file"], *m.get("extra", [])]
    print(f"{B}Downloading{X} {m['id']}  ({m['size_gb']:.1f} GB)")
    print(f"  from  {m['repo']}")
    print(f"  files {', '.join(files)}")
    print(f"  to    {dest}\n")
    # Plain HTTPS with curl: resumable (-C -), retried, no Python client needed —
    # works before aios-setup, and avoids hf_transfer hanging on Xet-backed repos.
    r = subprocess.CompletedProcess([], 0)
    for f in files:
        part = dest / (f + ".part")
        url = f"https://huggingface.co/{m['repo']}/resolve/main/{f}"
        r = subprocess.run(["curl", "-fL", "--retry", "5", "--retry-delay", "3", "-C", "-",
                            "--progress-bar", "-o", str(part), url])
        if r.returncode != 0:
            break
        part.rename(dest / f)
    if r.returncode == 0:
        # tells the AIOS backend how to list it (label, vision, uncensored)
        (dest / "praxis-model.json").write_text(json.dumps(
            {"id": m["id"], "label": m.get("label", m["id"]), "tags": m["tags"], "censored": m["censored"],
             "vision": "vision" in m["tags"], "desc": m["desc"]}, indent=2) + "\n")
        print(f"\n{G}✓ downloaded to {dest}{X} — pick it in the AI panel's model menu")
        if not m["censored"]:
            print(f"{Y}note{X}: this model is uncensored — it will answer bluntly without refusals.")
    else:
        die("download failed.")


def cmd_remove(model_id: str) -> None:
    dest = MODELS / model_id
    if not dest.exists():
        die(f"not installed: {model_id}")
    shutil.rmtree(dest)
    print(f"{G}✓ removed {dest}{X}")


def cmd_space(hw: dict) -> None:
    print_hw(hw); print()
    # per-model sizes on disk
    inst_sizes = {}
    if MODELS.exists():
        for d in MODELS.iterdir():
            if d.is_dir():
                inst_sizes[d.name] = sum(f.stat().st_size for f in d.rglob("*") if f.is_file()) / (1024**3)
    total = sum(inst_sizes.values())
    print(f"Installed model dir: {MODELS} — {total:.1f} GB across {len(inst_sizes)} models")


def die(msg: str, code: int = 1) -> None:
    print(f"{R}✗ {msg}{X}", file=sys.stderr); sys.exit(code)


def main() -> None:
    p = argparse.ArgumentParser(prog="praxis-models",
        description=textwrap.dedent(__doc__ or ""),
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=False)
    sub.add_parser("list")
    sub.add_parser("recommend")
    sub.add_parser("installed")
    sub.add_parser("space")
    dl = sub.add_parser("download"); dl.add_argument("id"); dl.add_argument("--force", action="store_true")
    rm = sub.add_parser("remove");   rm.add_argument("id")
    args = p.parse_args()
    hw = detect_hardware()
    if not args.cmd or args.cmd == "recommend": cmd_recommend(hw)
    elif args.cmd == "list":                     cmd_list(hw)
    elif args.cmd == "installed":                cmd_installed()
    elif args.cmd == "space":                    cmd_space(hw)
    elif args.cmd == "download":                 cmd_download(args.id, hw, args.force)
    elif args.cmd == "remove":                   cmd_remove(args.id)


if __name__ == "__main__":
    main()
