#!/usr/bin/env python3
"""
praxis-share-gate — the lock on a shared screen.

  praxis-share-gate serve  --listen PORT --to PORT --code CODE
  praxis-share-gate client --host H --port P --listen PORT --code CODE

Without this, praxis-share is an open screen and microphone-adjacent audio
feed to anyone on the network. With it, a viewer needs a four-digit code the
host is showing on its own screen.

The code is a TLS pre-shared key, not a password checked after connecting.
A client that does not know it fails the TLS handshake and never reaches
the stream at all, and because the handshake derives the session key from
the code, everything after it is encrypted too. No certificates, nothing to
copy between machines — read six digits off the other screen.

Four digits is 10^4, which is thin against an attacker who can try forever,
so the server stops listening to an address for a while after a few bad
handshakes, and the code is new for every session. That is proportionate to
a home or office network; it is not a reason to expose the port to the
internet.
"""
import argparse
import json
import re
import os
import secrets
import socket
import ssl
import subprocess
import sys
import threading
import time

ALPHABET = "0123456789"
CODE_LEN = 4  # four digits: easy to read across a desk; the lockout below keeps guessing slow
MAX_FAILS = 5
LOCKOUT_S = 60
IDENTITY = b"praxis-share"
import struct
import subprocess

BEACON_PORT = 5921
MCAST_GRP = "239.255.79.20"


def get_local_ip() -> str:
    for target in ["8.8.8.8", "1.1.1.1", "10.255.255.255"]:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect((target, 1))
            ip = s.getsockname()[0]
            s.close()
            if ip and not ip.startswith("127."):
                return ip
        except Exception:
            pass
    try:
        out = subprocess.check_output(["ip", "-4", "-o", "addr", "show", "scope", "global"], text=True, stderr=subprocess.DEVNULL)
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 4 and "/" in parts[3]:
                return parts[3].split("/")[0]
    except Exception:
        pass
    return "127.0.0.1"


def get_broadcast_addrs() -> list[str]:
    addrs = ["<broadcast>", "255.255.255.255"]
    local_ip = get_local_ip()
    if local_ip and local_ip != "127.0.0.1":
        parts = local_ip.split(".")
        if len(parts) == 4:
            addrs.append(f"{parts[0]}.{parts[1]}.{parts[2]}.255")
    try:
        out = subprocess.check_output(["ip", "-4", "-o", "addr", "show"], text=True, stderr=subprocess.DEVNULL)
        for line in out.splitlines():
            p = line.split()
            if "brd" in p:
                idx = p.index("brd")
                if idx + 1 < len(p):
                    addrs.append(p[idx + 1])
    except Exception:
        pass
    try:
        out = subprocess.check_output(["ip", "-4", "neigh"], text=True, stderr=subprocess.DEVNULL)
        for line in out.splitlines():
            p = line.split()
            if p and p[0] != "FAILED" and not p[0].startswith("127."):
                addrs.append(p[0])
    except Exception:
        pass
    return list(dict.fromkeys(addrs))


def start_beacon(listen_port: int) -> None:
    def _loop() -> None:
        hostname = socket.gethostname() or "Praxis PC"
        b_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        b_sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        b_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            b_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        except (AttributeError, OSError):
            pass
        try:
            b_sock.bind(("", BEACON_PORT))
        except OSError:
            pass
        try:
            mreq = struct.pack("4sl", socket.inet_aton(MCAST_GRP), socket.INADDR_ANY)
            b_sock.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, mreq)
        except OSError:
            pass

        while True:
            ip = get_local_ip()
            payload = json.dumps({
                "service": "praxis-share",
                "name": hostname,
                "ip": ip,
                "port": listen_port
            }).encode("utf-8")
            beacon_pkt = b"PRAXIS_BEACON:" + payload

            targets = get_broadcast_addrs()
            for tgt in targets:
                try:
                    b_sock.sendto(beacon_pkt, (tgt, BEACON_PORT))
                except OSError:
                    pass
            try:
                b_sock.sendto(beacon_pkt, (MCAST_GRP, BEACON_PORT))
            except OSError:
                pass

            t_end = time.time() + 1.5
            while time.time() < t_end:
                rem = max(0.1, t_end - time.time())
                b_sock.settimeout(rem)
                try:
                    data, addr = b_sock.recvfrom(2048)
                    if data == b"PRAXIS_DISCOVER":
                        b_sock.sendto(beacon_pkt, addr)
                except socket.timeout:
                    continue
                except OSError:
                    break

    threading.Thread(target=_loop, daemon=True).start()


def scan(timeout: float = 1.2) -> list[dict]:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
    except (AttributeError, OSError):
        pass
    try:
        s.bind(("", 0))
    except OSError:
        pass
    try:
        mreq = struct.pack("4sl", socket.inet_aton(MCAST_GRP), socket.INADDR_ANY)
        s.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, mreq)
    except OSError:
        pass

    discover_pkt = b"PRAXIS_DISCOVER"
    targets = get_broadcast_addrs()
    for tgt in targets:
        try:
            s.sendto(discover_pkt, (tgt, BEACON_PORT))
        except OSError:
            pass
    try:
        s.sendto(discover_pkt, (MCAST_GRP, BEACON_PORT))
    except OSError:
        pass

    devices: dict[str, dict] = {}
    my_ip = get_local_ip()
    end_time = time.time() + timeout
    while time.time() < end_time:
        rem = end_time - time.time()
        if rem <= 0:
            break
        s.settimeout(min(rem, 0.3))
        try:
            data, addr = s.recvfrom(2048)
            if data.startswith(b"PRAXIS_BEACON:"):
                info = json.loads(data[len(b"PRAXIS_BEACON:"):].decode("utf-8"))
                ip = info.get("ip") or addr[0]
                port = info.get("port", 5920)
                name = info.get("name") or ip
                if ip == "127.0.0.1" and addr[0] != "127.0.0.1":
                    ip = addr[0]
                key = f"{ip}:{port}"
                devices[key] = {
                    "name": name,
                    "ip": ip,
                    "port": port,
                    "is_self": (ip == my_ip)
                }
        except (socket.timeout, OSError, json.JSONDecodeError):
            pass
    s.close()

    # TCP probe fallback for active neighbors in ip neigh if not discovered via UDP
    for tgt in targets:
        if tgt in ["<broadcast>", "255.255.255.255"] or tgt.endswith(".255") or tgt == my_ip:
            continue
        key = f"{tgt}:5920"
        if key not in devices:
            try:
                tc = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                tc.settimeout(0.15)
                if tc.connect_ex((tgt, 5920)) == 0:
                    hostname = f"Praxis PC ({tgt})"
                    try:
                        h = socket.gethostbyaddr(tgt)[0]
                        if h:
                            hostname = h.split(".")[0]
                    except Exception:
                        pass
                    devices[key] = {
                        "name": hostname,
                        "ip": tgt,
                        "port": 5920,
                        "is_self": False
                    }
                tc.close()
            except Exception:
                pass

    return list(devices.values())


def new_code() -> str:
    return "".join(secrets.choice(ALPHABET) for _ in range(CODE_LEN))


def psk_from(code: str) -> bytes:
    # The code is short and low-entropy, so stretch it before it becomes key
    # material. PBKDF2 makes each guess cost something even if the handshake
    # itself could somehow be replayed offline.
    import hashlib
    return hashlib.pbkdf2_hmac("sha256", code.encode(), b"praxis-share-v1", 200_000, 32)


def pipe(a: socket.socket, b: socket.socket) -> None:
    try:
        while True:
            data = a.recv(65536)
            if not data:
                break
            b.sendall(data)
    except (OSError, ssl.SSLError):
        pass
    finally:
        try:
            b.shutdown(socket.SHUT_WR)
        except OSError:
            pass


def serve(listen_port: int, to_port: int, code: str, on_connect: str | None = None) -> int:
    key = psk_from(code)
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.set_ciphers("PSK")
    ctx.set_psk_server_callback(lambda identity: key, IDENTITY.decode())

    fails: dict[str, list] = {}
    state_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}") + "/praxis-share"
    os.makedirs(state_dir, exist_ok=True)
    clients_file = os.path.join(state_dir, "clients.json")
    clients_lock = threading.Lock()
    active_clients: dict[str, int] = {}

    def update_clients(ip: str, delta: int):
        with clients_lock:
            cur = active_clients.get(ip, 0) + delta
            if cur <= 0:
                active_clients.pop(ip, None)
            else:
                active_clients[ip] = cur
            try:
                tmp = clients_file + ".tmp"
                with open(tmp, "w") as f:
                    json.dump({"count": len(active_clients), "clients": list(active_clients.keys())}, f)
                os.replace(tmp, clients_file)
            except Exception:
                pass

    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(("0.0.0.0", listen_port))
    srv.listen(8)
    print(f"gate: listening on {listen_port}, forwarding to 127.0.0.1:{to_port}", flush=True)
    start_beacon(listen_port)

    while True:
        try:
            raw, addr = srv.accept()
        except OSError:
            break
        ip = addr[0]
        rec = fails.get(ip)
        if rec and rec[0] >= MAX_FAILS and time.time() - rec[1] < LOCKOUT_S:
            raw.close()
            continue

        def handle(raw=raw, ip=ip):
            try:
                tls = ctx.wrap_socket(raw, server_side=True)
            except (ssl.SSLError, OSError):
                r = fails.setdefault(ip, [0, 0.0])
                r[0] += 1
                r[1] = time.time()
                print(f"gate: refused {ip} (wrong code, {r[0]})", flush=True)
                try:
                    raw.close()
                except OSError:
                    pass
                return
            fails.pop(ip, None)
            print(f"gate: {ip} accepted", flush=True)
            # A current viewer opens with one line naming its own screen, so
            # the extra display is made pixel for pixel to match it instead of
            # a fixed 1920x1080 stretched over a sharper panel. Older viewers
            # send nothing; give up after a moment and use the default.
            env = {**os.environ, 'PRAXIS_SHARE_PEER': ip}
            try:
                tls.settimeout(1.5)
                hello = b""
                while not hello.endswith(b"\n") and len(hello) < 64:
                    ch = tls.recv(1)
                    if not ch:
                        break
                    hello += ch
                m = re.fullmatch(rb"PRAXIS-RES (\d{3,5})x(\d{3,5})@(\d{2,3})\n", hello)
                if m:
                    env['PRAXIS_SHARE_RES'] = m.expand(rb"\1x\2@\3").decode()
            except (socket.timeout, ssl.SSLError, OSError):
                pass
            finally:
                tls.settimeout(None)
            if on_connect:
                try:
                    # tell the stream who connected, so it can pick a bitrate
                    # to suit the link (Wi-Fi or a cable)
                    subprocess.run(on_connect, shell=True, check=True,
                                   env=env)
                except Exception as e:
                    print(f"gate: on-connect failed: {e}", flush=True)

            up = None
            t_giveup = time.time() + 4.0
            while time.time() < t_giveup:
                try:
                    up = socket.create_connection(("127.0.0.1", to_port), timeout=1.0)
                    break
                except OSError:
                    time.sleep(0.2)
            if not up:
                print(f"gate: stream not reachable: {to_port}", flush=True)
                tls.close()
                return

            update_clients(ip, +1)
            t1 = threading.Thread(target=pipe, args=(tls, up), daemon=True)
            t2 = threading.Thread(target=pipe, args=(up, tls), daemon=True)
            t1.start()
            t2.start()

            def monitor_session():
                t2.join()
                update_clients(ip, -1)

            threading.Thread(target=monitor_session, daemon=True).start()

        threading.Thread(target=handle, daemon=True).start()
    return 0


def client(host: str, port: int, listen_port: int, code: str, res: str | None = None) -> int:
    key = psk_from(code)
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    ctx.set_ciphers("PSK")
    ctx.set_psk_client_callback(lambda hint: (IDENTITY.decode(), key))

    try:
        tls = ctx.wrap_socket(socket.create_connection((host, port), timeout=10),
                              server_hostname=None)
    except ssl.SSLError:
        print("praxis-share-gate: the code was not accepted", file=sys.stderr)
        return 4
    except OSError as e:
        print(f"praxis-share-gate: cannot reach {host}:{port} ({e})", file=sys.stderr)
        return 3

    if res:
        tls.sendall(f"PRAXIS-RES {res}\n".encode())

    lsn = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    lsn.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        lsn.bind(("127.0.0.1", listen_port))
    except OSError:
        lsn.bind(("127.0.0.1", 0))
    actual_port = lsn.getsockname()[1]
    lsn.listen(1)
    print(f"gate: connected — play from 127.0.0.1:{actual_port}", flush=True)
    local, _ = lsn.accept()
    t1 = threading.Thread(target=pipe, args=(tls, local), daemon=True)
    t2 = threading.Thread(target=pipe, args=(local, tls), daemon=True)
    t1.start(); t2.start()
    t1.join()
    return 0


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(add_help=True)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("serve")
    s.add_argument("--listen", type=int, required=True)
    s.add_argument("--to", type=int, required=True)
    s.add_argument("--code", required=True)
    s.add_argument("--on-connect", default=None)
    c = sub.add_parser("client")
    c.add_argument("--host", required=True)
    c.add_argument("--port", type=int, required=True)
    c.add_argument("--listen", type=int, required=True)
    c.add_argument("--code", required=True)
    c.add_argument("--res", help="this screen, WxH@Hz, so the host matches it")
    sub.add_parser("newcode")
    sub.add_parser("scan")
    a = ap.parse_args(argv)
    if a.cmd == "newcode":
        print(new_code()); return 0
    if a.cmd == "scan":
        print(json.dumps(scan()))
        return 0
    if a.cmd == "serve":
        return serve(a.listen, a.to, a.code, a.on_connect)
    return client(a.host, a.port, a.listen, a.code, a.res)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(0)
