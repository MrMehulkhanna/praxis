#!/usr/bin/env python3
"""
praxis-bluetooth-agent — Robust D-Bus authentication agent for Bluetooth pairing
Handles keyboard PIN codes, passkeys, and service authorizations without relying on
notification daemons or desktop applets that may be hidden by Do Not Disturb.
"""

import sys
import os
import signal
import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib

AGENT_PATH = "/praxis/bluetooth/agent"

class BluetoothAgent(dbus.service.Object):
    def __init__(self, bus, path):
        super().__init__(bus, path)

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Release(self):
        print("[Praxis Agent] Released")

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        msg = f"Type PIN on keyboard: {pincode} and press ENTER"
        print(f"\n=======================================================")
        print(f"  KEYBOARD PAIRING PIN: {pincode}")
        print(f"  Type {pincode} on your keyboard and press ENTER!")
        print(f"=======================================================\n", flush=True)
        os.system(f'notify-send -u critical "Bluetooth Keyboard PIN" "Type <b>{pincode}</b> on your keyboard and press Enter" 2>/dev/null || true')

    @dbus.service.method("org.bluez.Agent1", in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        key = f"{passkey:06d}"
        print(f"\n=======================================================")
        print(f"  KEYBOARD PAIRING PASSKEY: {key}")
        print(f"  Type {key} on your keyboard and press ENTER!")
        print(f"=======================================================\n", flush=True)
        os.system(f'notify-send -u critical "Bluetooth Passkey" "Type <b>{key}</b> on your keyboard and press Enter" 2>/dev/null || true')

    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        key = f"{passkey:06d}"
        print(f"[Praxis Agent] Confirmation request for passkey {key} -> Auto-Approved", flush=True)
        return

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        print(f"[Praxis Agent] Authorization request for {device} -> Auto-Approved", flush=True)
        return

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def AuthorizeService(self, device, uuid):
        print(f"[Praxis Agent] Authorizing HID service {uuid} for {device}", flush=True)
        return

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        print(f"[Praxis Agent] Device requested passkey, providing 000000", flush=True)
        return dbus.UInt32(0)

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="s")
    def RequestPinCode(self, device):
        print(f"[Praxis Agent] Device requested PIN, providing 0000", flush=True)
        return "0000"

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        print("[Praxis Agent] Pairing request was cancelled by the device", flush=True)

def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()

    agent = BluetoothAgent(bus, AGENT_PATH)
    mgr = dbus.Interface(bus.get_object("org.bluez", "/org/bluez"), "org.bluez.AgentManager1")

    capability = sys.argv[1] if len(sys.argv) > 1 else "KeyboardDisplay"

    try:
        mgr.RegisterAgent(AGENT_PATH, capability)
        mgr.RequestDefaultAgent(AGENT_PATH)
        print(f"[Praxis Agent] Registered with capability '{capability}' as default agent.", flush=True)
    except Exception as e:
        print(f"[Praxis Agent] Registration failed: {e}", file=sys.stderr, flush=True)
        sys.exit(1)

    loop = GLib.MainLoop()

    def handle_sig(sig, frame):
        try:
            mgr.UnregisterAgent(AGENT_PATH)
        except Exception:
            pass
        loop.quit()

    signal.signal(signal.SIGINT, handle_sig)
    signal.signal(signal.SIGTERM, handle_sig)

    try:
        loop.run()
    finally:
        try:
            mgr.UnregisterAgent(AGENT_PATH)
        except Exception:
            pass

if __name__ == "__main__":
    main()
