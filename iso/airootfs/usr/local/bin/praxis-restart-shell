#!/usr/bin/env bash
# ============================================================================
#  praxis-restart-shell — restart the Praxis desktop shell (bar, dock, panels)
# ============================================================================
set -uo pipefail

pkill -x quickshell 2>/dev/null || true
sleep 0.5
pkill -9 -x quickshell 2>/dev/null || true
sleep 0.3
# a shell started by root (e.g. during an update) can't be stopped by the user —
# without this, the old and the new shell both run and every bar is drawn twice
if [ "$EUID" -ne 0 ] && pgrep -x quickshell >/dev/null; then
    exec sudo -n /usr/local/bin/praxis-restart-shell
fi

# Start the shell through the window manager, so it gets the session's full
# environment (instance signature, D-Bus session bus, PATH, theme …). A shell
# started straight from sudo had a broken signature and no session bus: night
# light, notifications and other controls then silently did nothing.
QS_CMD='quickshell -d -p "$HOME/.config/quickshell/shell.qml"'
if [ "$EUID" -eq 0 ]; then
    DESKTOP_USER=$(ps -eo user:32,comm | awk '$2 ~ /^Hyprland$/ && $1 != "root" {print $1; exit}')
    [ -n "$DESKTOP_USER" ] || DESKTOP_USER=$(who | awk '$1 != "root" {print $1; exit}')
    [ -n "$DESKTOP_USER" ] || { echo "praxis-restart-shell: no desktop session found" >&2; exit 1; }
    RUNTIME="/run/user/$(id -u "$DESKTOP_USER")"
    if sudo -u "$DESKTOP_USER" env XDG_RUNTIME_DIR="$RUNTIME" hyprctl -i 0 dispatch "hl.dsp.exec_cmd('$QS_CMD')" >/dev/null 2>&1; then
        exit 0
    fi
    echo "praxis-restart-shell: the session did not answer — log out and back in to restart the desktop" >&2
    exit 1
fi

if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && hyprctl dispatch "hl.dsp.exec_cmd('$QS_CMD')" >/dev/null 2>&1; then
    exit 0
fi
nohup quickshell -d -p "$HOME/.config/quickshell/shell.qml" >/dev/null 2>&1 &
