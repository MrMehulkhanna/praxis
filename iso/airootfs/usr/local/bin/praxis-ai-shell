#!/usr/bin/env python3
"""
praxis-ai-shell — persistent REPL over AIOS with in-terminal history.

Talks to the same /api/chat as `ai ask`, but keeps a single conversation
context so follow-ups actually follow up. Arrow keys work (readline), and
!bang commands drop out to a shell:

    praxis > what is the capital of France?
    praxis > follow-up: and its population?
    praxis > !ls -la
    praxis > /model qwen2.5-7b-instruct
    praxis > /clear     # new conversation
    praxis > /exit
"""
import json, os, pathlib, readline, subprocess, sys, time, urllib.request

BASE  = "http://127.0.0.1:8778"
HIST  = pathlib.Path.home() / ".praxis-ai-shell.history"
CONVO = f"shell-{int(time.time())}"
MODEL = "auto"

D, B, G, Y, R, C, M, X = (
    ("\033[2m","\033[1m","\033[32m","\033[33m","\033[31m","\033[36m","\033[35m","\033[0m")
    if sys.stdout.isatty() else ("",)*8
)


def api(path: str, data=None):
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(BASE + path, data=body,
        method="POST" if body else "GET",
        headers={"Content-Type": "application/json"} if body else {})
    with urllib.request.urlopen(req, timeout=120) as r:
        return r.read().decode()


def ask(text: str) -> str:
    try:
        body = api("/api/chat", {
            "message": text, "conversation_id": CONVO, "model": MODEL})
    except urllib.error.URLError:
        return f"{R}AIOS backend down (systemctl --user start aios.service){X}"
    # /api/chat can stream SSE or return JSON — accept both
    try:
        j = json.loads(body)
        for k in ("content", "text", "answer", "message"):
            if isinstance(j, dict) and k in j:
                return str(j[k]).strip()
        return json.dumps(j)[:600]
    except json.JSONDecodeError:
        chunks = []
        for line in body.splitlines():
            if line.startswith("data:"):
                s = line[5:].strip()
                if s in ("[DONE]", ""): continue
                try:
                    j = json.loads(s)
                    for k in ("delta", "content", "text"):
                        if isinstance(j, dict) and k in j:
                            chunks.append(str(j[k])); break
                except json.JSONDecodeError:
                    chunks.append(s)
        return "".join(chunks).strip() or "(no answer)"


def sh(cmd: str) -> None:
    try:
        subprocess.run(cmd, shell=True, executable="/bin/bash", check=False)
    except KeyboardInterrupt:
        pass


def main() -> None:
    global MODEL, CONVO
    try:
        readline.read_history_file(HIST)
    except FileNotFoundError:
        pass
    readline.set_history_length(1000)

    print(f"{B}Praxis AI shell{X}  {D}(convo {CONVO}, model {MODEL} — /help for commands){X}")
    while True:
        try:
            line = input(f"{C}praxis › {X}").strip()
        except EOFError:
            print(); break
        except KeyboardInterrupt:
            print(); continue
        if not line:
            continue

        if line.startswith("!"):
            sh(line[1:]); continue
        if line in ("/exit", "/quit", "/q"):
            break
        if line == "/help":
            print(f"  {B}/model <id>{X}   use a specific model (or 'auto')")
            print(f"  {B}/clear{X}        start a new conversation")
            print(f"  {B}/model?{X}       show current model")
            print(f"  {B}/exit{X}         quit  ({B}!cmd{X} runs a shell command)")
            continue
        if line == "/model?":
            print(f"  model = {MODEL}"); continue
        if line.startswith("/model "):
            MODEL = line.split(None, 1)[1].strip(); print(f"  {G}model = {MODEL}{X}"); continue
        if line == "/clear":
            CONVO = f"shell-{int(time.time())}"; print(f"  {G}new conversation: {CONVO}{X}"); continue

        answer = ask(line)
        print(f"{answer}\n")

    try:
        readline.write_history_file(HIST)
    except OSError:
        pass


if __name__ == "__main__":
    main()
