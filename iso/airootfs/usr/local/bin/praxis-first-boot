#!/usr/bin/env bash
# praxis-first-boot — one welcome notification per account (every boot on
# live media, where nothing persists). On live media it carries an
# "Install Praxis Linux" action that opens the installer.
set -uo pipefail
command -v notify-send >/dev/null || exit 0

# The notification daemon starts with the compositor; give it a moment.
for _ in $(seq 1 40); do
    busctl --user status org.freedesktop.Notifications >/dev/null 2>&1 && break
    sleep 0.5
done

if [ -d /run/archiso ]; then
    action=$(notify-send -a "Praxis" -u normal -t 0 --wait \
        --action=install="Install Praxis Linux" \
        "Welcome to Praxis Linux — live session" \
        "Everything is running from the USB drive. Install Praxis on this computer from here or from the dock — next to Windows, in free space, or on a whole disk.")
    [ "$action" = "install" ] && exec /usr/local/bin/praxis-installer
    exit 0
fi

touch "$HOME/.praxis-first-boot-done"
if [ -f "$HOME/.aios-setup-done" ]; then
    notify-send -a "Praxis" -t 12000 "Welcome to Praxis Linux" \
        "Super+Space opens the palette, Super+H types what you say, Super+O is Control Center. Type 'praxis' in a terminal to see every command."
    exit 0
fi
action=$(notify-send -a "Praxis" -u normal -t 0 --wait \
    --action=ai="Set up the AI" --action=keys="Keyboard shortcuts" \
    "Welcome to Praxis Linux" \
    "Set up the local AI assistant now (a few minutes, needs internet) — or later from Settings › AI. Super+Space opens the palette.")
case "$action" in
    ai)   exec kitty --class praxis-setup --title "Set up the AI" -e bash -c 'aios-setup; echo; read -rp "Press Enter to close… " _' ;;
    keys) exec quickshell ipc -p "$HOME/.config/quickshell/shell.qml" call shell settings Keyboard ;;
esac
