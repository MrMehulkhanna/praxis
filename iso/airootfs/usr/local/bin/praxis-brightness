#!/usr/bin/env bash
# praxis-brightness — nudge screen brightness with a floating notification.
# Never goes fully dark: 10 % on an OLED panel (0 % turns it black, like a dead
# screen — detected from the panel's EDID, as the shell does), 1 % otherwise.
# Uses brightnessctl (fast, keeps state).  Steps in 5% by default.
#
# Picks the backlight that really drives the built-in screen. Laptops often
# have two (e.g. acpi_video0 next to intel_backlight / amdgpu_bl1 /
# nvidia_wmi_ec_backlight), and brightnessctl on its own takes the first one
# it finds — on many HP and hybrid-GPU laptops that one does nothing.
#
# Usage:  praxis-brightness up | down | set N | get | save | restore | device
set -uo pipefail

command -v brightnessctl >/dev/null || { echo "install brightnessctl" >&2; exit 1; }

# Collect all available backlight devices
ALL_DEVS=()
for b in /sys/class/backlight/*; do
    [ -e "$b/brightness" ] || continue
    [ "$(cat "$b/max_brightness" 2>/dev/null || echo 0)" -gt 0 ] || continue
    ALL_DEVS+=("${b##*/}")
done

# best backlight: the GPU's own (raw) hardware PWM (intel_backlight, amdgpu_bl)
# directly powers the display LEDs, followed by platform/EC controllers
# (nvidia_wmi_ec_backlight), then ACPI firmware.
pick_device() {
    local b name type dev score best="" best_score=-1 c
    for b in /sys/class/backlight/*; do
        [ -e "$b/brightness" ] || continue
        name=${b##*/}; type=$(cat "$b/type" 2>/dev/null); score=1
        case "$type" in
            raw)
                score=10
                dev=$(readlink -f "$b/device" 2>/dev/null)
                for c in /sys/class/drm/card*-eDP-* /sys/class/drm/card*-LVDS-* /sys/class/drm/card*-DSI-*; do
                    [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
                    if [ "$(readlink -f "$c")" = "$dev" ] || [ "$(readlink -f "$c/device/device")" = "$dev" ]; then
                        score=15
                    fi
                done ;;
            platform) score=6 ;;
            firmware) score=3 ;;
        esac
        [ "$(cat "$b/max_brightness" 2>/dev/null || echo 0)" -gt 0 ] || score=0
        if [ "$score" -gt "$best_score" ]; then best=$name; best_score=$score; fi
    done
    echo "$best"
}

PREF_DEV=""
if [ -f "$HOME/.config/praxis/backlight" ]; then
    PREF_DEV=$(cat "$HOME/.config/praxis/backlight" 2>/dev/null | tr -d '[:space:]')
elif [ -f /etc/praxis/backlight ]; then
    PREF_DEV=$(cat /etc/praxis/backlight 2>/dev/null | tr -d '[:space:]')
fi

DEV=${PRAXIS_BACKLIGHT:-${PREF_DEV:-$(pick_device)}}
if [ -z "$DEV" ]; then
    [ "${1:-}" = get ] && { echo "100%"; exit 0; }
    echo "praxis-brightness: no screen backlight found (external monitor, or the GPU driver is not loaded)" >&2
    exit 1
fi

# Multi-controller sync: adjusts the primary backlight AND syncs all secondary controllers
# in lockstep so hybrid Intel+NVIDIA / AMD+NVIDIA laptops respond regardless of which chip
# is physically wired to the backlight PWM circuit.
bc() {
    brightnessctl -d "$DEV" "$@"
    for d in "${ALL_DEVS[@]}"; do
        [ "$d" = "$DEV" ] && continue
        brightnessctl -d "$d" "$@" 2>/dev/null || true
    done
}

step=${STEP:-5}
floor=1
for e in /sys/class/drm/card*-eDP-*/edid; do
    [ -r "$e" ] && grep -aq ATNA "$e" && floor=10      # Samsung OLED panels (sysfs sizes read 0)
done
case "${1:-up}" in
    up)      bc -e -n"$floor%" -q set "${step}%+" ;;
    down)    bc -e -n"$floor%" -q set "${step}%-" ;;
    set)     bc -e -n"$floor%" -q set "${2:?value}%" ;;
    get)     bc -e -m | awk -F, '{print $4}'; exit 0 ;;
    save)    bc -q -s set "${2:-15}%" >/dev/null; exit 0 ;;          # dim (idle) and remember the level
    restore) bc -q -r; exit 0 ;;
    device)  echo "$DEV"; exit 0 ;;
    list)
        echo "Active backlight: $DEV"
        echo "Available backlight devices:"
        for d in "${ALL_DEVS[@]}"; do
            t=$(cat "/sys/class/backlight/$d/type" 2>/dev/null || echo "unknown")
            m=$(cat "/sys/class/backlight/$d/max_brightness" 2>/dev/null || echo "0")
            c=$(cat "/sys/class/backlight/$d/brightness" 2>/dev/null || echo "0")
            pct=0
            [ "$m" -gt 0 ] && pct=$(( c * 100 / m ))
            if [ "$d" = "$DEV" ]; then
                echo "  * $d (type: $t, brightness: $pct%, max: $m) [SELECTED]"
            else
                echo "    $d (type: $t, brightness: $pct%, max: $m)"
            fi
        done
        exit 0
        ;;
    use)
        target="${2:?device name required (see: praxis-brightness list)}"
        if [ ! -d "/sys/class/backlight/$target" ]; then
            echo "Error: device '$target' does not exist in /sys/class/backlight/" >&2
            echo "Available: ${ALL_DEVS[*]}" >&2
            exit 1
        fi
        mkdir -p "$HOME/.config/praxis"
        echo "$target" > "$HOME/.config/praxis/backlight"
        echo "Now using '$target' as primary backlight (saved to ~/.config/praxis/backlight)"
        exit 0
        ;;
    *)       echo "usage: praxis-brightness up|down|set N|get|save [N]|restore|device|list|use <dev>" >&2; exit 2 ;;
esac

pct=$(bc -e -m | awk -F, '{print $4}' | tr -d '%')
if [ -z "${PRAXIS_QUIET:-}" ] && command -v notify-send >/dev/null; then   # quiet: the shell's own slider
    notify-send -a "Praxis" -t 900 -h "int:value:$pct" -h "string:x-canonical-private-synchronous:brightness" \
        "󰃞 Brightness" "${pct}%"
fi
